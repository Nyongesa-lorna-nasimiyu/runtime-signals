---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import { FailureLab } from '@/components/FailureLab';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { articlePath } from '@/lib/resolve';
import { BUILD_TIME } from '@/lib/build-time';

const [artifacts, articles, briefs] = await Promise.all([
  getCollection('artifacts'),
  getCollection('articles'),
  getCollection('briefs'),
]);
const live = getPublishedEntries([...articles, ...briefs], BUILD_TIME);
const kindCount = new Set(artifacts.map((artifact) => artifact.data.kind)).size;

const artifactCards = artifacts
  .slice()
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((artifact) => {
    const linked = live.filter((entry) =>
      entry.data.artifacts.some((reference) => reference.id === artifact.id),
    );
    return {
      artifact,
      linked: linked.map((entry) => ({
        id: entry.id,
        title: entry.data.title,
        path: articlePath(entry),
      })),
    };
  });
---

<BaseLayout
  title="Artifacts & Invariant Lab"
  description="Companion repositories, evaluation benchmarks, datasets, and interactive failure reproducers referenced across Runtime Signals investigations."
  canonicalPath="/artifacts"
>
  <div class="artifacts-page shell">
    <PageHero
      eyebrow="Reproducible Engineering Lab"
      title="Artifacts & Invariant Lab"
      description="Companion repositories, evaluation benchmarks, datasets, and interactive failure reproducers referenced across Runtime Signals investigations."
    >
      <div slot="panel" class="artifact-stats">
        <div>
          <span class="artifact-stats__value">{artifacts.length}</span>
          <span class="artifact-stats__label">Published artifacts</span>
        </div>
        <div>
          <span class="artifact-stats__value">{kindCount}</span>
          <span class="artifact-stats__label">Artifact types</span>
        </div>
        <div>
          <span class="artifact-stats__value">
            {artifactCards.reduce((sum, item) => sum + item.linked.length, 0)}
          </span>
          <span class="artifact-stats__label">Article references</span>
        </div>
      </div>
    </PageHero>

    <section class="lab-section" aria-label="Interactive invariant lab">
      <p class="eyebrow">Interactive Failure Reproducer</p>
      <FailureLab client:idle />
    </section>

    <section class="artifact-registry" aria-labelledby="artifact-registry-title">
      <div class="artifact-registry__head">
        <div>
          <p class="eyebrow">Published Code &amp; Datasets</p>
          <h2 id="artifact-registry-title" class="artifact-registry__title">
            Repository &amp; dataset artifacts ({artifacts.length})
          </h2>
        </div>
        <a href="/methodology" class="artifact-registry__link">
          How artifacts are graded
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="artifact-grid">
        {
          artifactCards.map(({ artifact, linked }) => (
            <article class="artifact-card card">
              <div class="artifact-card__top">
                <span class="artifact-card__kind">{artifact.data.kind}</span>
                <a
                  href={artifact.data.url}
                  class="artifact-card__open"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>Open</span>
                  <Icon name="external-link" size={12} />
                </a>
              </div>

              <h3 class="artifact-card__title">{artifact.data.title}</h3>
              <p class="artifact-card__description">{artifact.data.description}</p>

              {linked.length > 0 && (
                <div class="artifact-card__links">
                  <span class="artifact-card__links-label">Referenced in</span>
                  {linked.map((entry) => (
                    <a href={entry.path}>{entry.title}</a>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .artifacts-page {
    padding-block: var(--space-7) var(--space-9);
  }

  .artifact-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .artifact-stats > div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .artifact-stats__value {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .artifact-stats__label {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .lab-section {
    margin-top: var(--space-6);
  }

  .lab-section :global(.lab) {
    margin-block: var(--space-4) 0;
  }

  .artifact-registry {
    margin-top: var(--space-7);
  }

  .artifact-registry__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--hairline);
  }

  .artifact-registry__title {
    margin: var(--space-1) 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .artifact-registry__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--signal);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
  }

  .artifact-registry__link:hover {
    text-decoration: underline;
  }

  .artifact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .artifact-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: var(--space-5);
  }

  .artifact-card:hover {
    border-color: var(--signal);
  }

  .artifact-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .artifact-card__kind {
    color: var(--signal);
    text-transform: uppercase;
  }

  .artifact-card__open {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--evidence-supported);
    text-decoration: none;
  }

  .artifact-card__open:hover {
    text-decoration: underline;
  }

  .artifact-card__title {
    margin: var(--space-3) 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .artifact-card__description {
    margin: var(--space-2) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .artifact-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  .artifact-card__links-label {
    color: var(--ink-muted);
  }

  .artifact-card__links a {
    color: var(--signal);
    text-decoration: none;
  }

  .artifact-card__links a:hover {
    text-decoration: underline;
  }

  @media (min-width: 40rem) {
    .artifact-registry__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .artifact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .artifact-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
