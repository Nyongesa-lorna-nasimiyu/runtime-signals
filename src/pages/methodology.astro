---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import EvidenceStrip from '@/components/EvidenceStrip.astro';
import EvidenceTag from '@/components/EvidenceTag.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { BUILD_TIME } from '@/lib/build-time';
import { evidenceCounts, type EvidenceStrength } from '@/lib/resolve';

const [articles, briefs, sources, topics] = await Promise.all([
  getCollection('articles'),
  getCollection('briefs'),
  getCollection('sources'),
  getCollection('topics'),
]);

const live = getPublishedEntries([...articles, ...briefs], BUILD_TIME);
const claimCounts = evidenceCounts(live);
const totalClaims = Object.values(claimCounts).reduce((sum, count) => sum + count, 0);
const primarySources = sources.filter((source) => source.data.primary).length;

const chain = [
  { label: 'Research claim', detail: 'What the literature or docs say, and its limitations' },
  { label: 'Runtime invariant', detail: 'The rule that actually gets violated in production' },
  { label: 'Operational evidence', detail: 'Traces, costs, failures, recovery behavior' },
  { label: 'Reproducible artifact', detail: 'What a reader can run or inspect themselves' },
];

const grades: {
  grade: EvidenceStrength;
  description: string;
  rule: string;
}[] = [
  {
    grade: 'supported',
    description:
      'Backed directly by a primary source - standards, papers, official docs, or source repositories.',
    rule: 'Requires a source record. Gated at schema validation.',
  },
  {
    grade: 'mixed',
    description:
      'Partially supported by available telemetry or studies; the boundary gap is stated explicitly.',
    rule: 'Requires a source record and a stated boundary gap.',
  },
  {
    grade: 'inference',
    description:
      'Engineering reasoning derived from cited runtime behavior, not a direct source quotation.',
    rule: 'Cites the runtime behavior it reasons from.',
  },
  {
    grade: 'opinion',
    description: 'Editorial judgment on architectural trade-offs, labeled explicitly as judgment.',
    rule: 'Labeled judgment, never presented as measured fact.',
  },
];

const tiers = [
  {
    title: 'Primary record',
    detail:
      'Standards, specifications, official documentation, source repositories, and original papers.',
  },
  {
    title: 'Production account',
    detail: 'Maintainer-authored engineering reports and reproducible production write-ups.',
  },
  {
    title: 'Verification material',
    detail: 'Benchmark and dataset documentation, plus the code used to verify it.',
  },
  {
    title: 'Secondary context',
    detail:
      'Credible analysis for discovery or context, but never sole proof for a consequential claim.',
  },
];

const gate = [
  {
    label: 'Schema gate',
    detail:
      'A supported or mixed claim without a source stops the build. The rule lives in the content schema, not in editorial memory.',
  },
  {
    label: 'Source record',
    detail:
      'Each record preserves its URL, publisher, publication date, access date, source type, and what it supports.',
  },
  {
    label: 'Human gate',
    detail:
      'Readiness does not grant permission to publish. A reviewed pull request and named approval authorize the exact commit being built.',
  },
];
---

<BaseLayout
  title="Methodology"
  description="How Runtime Signals sources, grades, and reviews assertions before publication."
  canonicalPath="/methodology"
>
  <div class="methodology-page shell">
    <PageHero
      eyebrow="Methodology · Evidence Protocol"
      title="How claims are sourced and labeled"
      description="How Runtime Signals sources, grades, and reviews assertions before publication, and what happens when the evidence is incomplete."
    >
      <div slot="panel">
        <div class="methodology-stats">
          <div class="methodology-stat">
            <span class="methodology-stat__value">{live.length}</span>
            <span class="methodology-stat__label">Live pieces</span>
          </div>
          <div class="methodology-stat">
            <span class="methodology-stat__value">{totalClaims}</span>
            <span class="methodology-stat__label">Graded claims</span>
          </div>
          <div class="methodology-stat">
            <span class="methodology-stat__value">{sources.length}</span>
            <span class="methodology-stat__label">Source records</span>
          </div>
        </div>
        <EvidenceStrip counts={claimCounts} label="Evidence across the live corpus" />
      </div>
    </PageHero>

    <div class="methodology-layout">
      <aside class="methodology-rail" aria-label="Methodology contents and references">
        <nav class="methodology-nav" aria-labelledby="methodology-nav-title">
          <p id="methodology-nav-title" class="eyebrow">On this page</p>
          <ol>
            <li><a href="#chain"><span aria-hidden="true">01</span> Evidence chain</a></li>
            <li><a href="#labels"><span aria-hidden="true">02</span> Evidence labels</a></li>
            <li><a href="#gate"><span aria-hidden="true">03</span> Publication gate</a></li>
            <li><a href="#priority"><span aria-hidden="true">04</span> Source priority</a></li>
            <li>
              <a href="#record"><span aria-hidden="true">05</span> Corrections &amp; record</a>
            </li>
          </ol>
        </nav>

        <div class="rail-card">
          <p class="eyebrow">Open the record</p>
          <ul class="rail-links">
            <li>
              <a href="/sources"
                >{sources.length} source records <span aria-hidden="true">→</span></a
              >
            </li>
            <li>
              <a href="/artifacts"
                >Artifacts &amp; invariant lab <span aria-hidden="true">→</span></a
              >
            </li>
            <li>
              <a href="/editorial-policy">Review &amp; approval <span aria-hidden="true">→</span></a
              >
            </li>
          </ul>
        </div>

        <div class="rail-card rail-card--quiet">
          <p class="eyebrow">Current register</p>
          <dl class="rail-facts">
            <div><dt>Topics</dt><dd>{topics.length}</dd></div>
            <div><dt>Primary sources</dt><dd>{primarySources}</dd></div>
            <div><dt>Evidence labels</dt><dd>4</dd></div>
          </dl>
        </div>
      </aside>

      <div class="methodology-body">
        <section id="chain" class="method-section" aria-labelledby="chain-title">
          <p class="eyebrow">01 · Evidence chain</p>
          <h2 id="chain-title">Every piece connects four layers</h2>
          <p class="method-lede">
            A piece starts with a real failure mechanism, not a news peg. The editorial unit is the
            chain from what is claimed to what a reader can inspect.
          </p>

          <ol class="chain-grid">
            {
              chain.map((link, index) => (
                <li class="chain-card">
                  <span class="chain-card__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="chain-card__label">{link.label}</span>
                  <span class="chain-card__detail">{link.detail}</span>
                </li>
              ))
            }
          </ol>
        </section>

        <section id="labels" class="method-section" aria-labelledby="labels-title">
          <p class="eyebrow">02 · Evidence labels</p>
          <h2 id="labels-title">Four labels, one visible rule</h2>
          <p class="method-lede">
            Every consequential claim carries a label shown on the piece itself. The label describes
            the support behind the claim, not the confidence of the author.
          </p>

          <div class="grade-grid">
            {
              grades.map((item) => (
                <article class="grade-card">
                  <div class="grade-card__top">
                    <EvidenceTag evidence={item.grade} />
                    <span class="grade-card__count">
                      {claimCounts[item.grade]} {claimCounts[item.grade] === 1 ? 'claim' : 'claims'}
                    </span>
                  </div>
                  <p>{item.description}</p>
                  <p class="grade-card__rule">{item.rule}</p>
                </article>
              ))
            }
          </div>

          <p class="method-callout">
            A claim labeled <EvidenceTag evidence="supported" /> or <EvidenceTag evidence="mixed" />
            {' '}is rejected at the publication gate if it cites no source. That rule is enforced in
            the content schema, not just editorial review.
          </p>
        </section>

        <section id="gate" class="method-section" aria-labelledby="gate-title">
          <p class="eyebrow">03 · Publication gate</p>
          <h2 id="gate-title">Nothing ships on confidence alone</h2>
          <p class="method-lede">
            Three checks stand between a draft and a public URL. Each one is structural, so a
            missing source or an unapproved change cannot be talked past.
          </p>

          <ol class="gate-list">
            {
              gate.map((item, index) => (
                <li class="gate-item">
                  <span class="gate-item__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3>{item.label}</h3>
                    <p>{item.detail}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <p class="method-note">
            See <a href="/editorial-policy">editorial policy</a> for the review workflow and the separate
            publication authorization step.
          </p>
        </section>

        <section id="priority" class="method-section" aria-labelledby="priority-title">
          <p class="eyebrow">04 · Source priority</p>
          <h2 id="priority-title">Ranked, not arbitrary</h2>
          <p class="method-lede">
            A lower tier only backs a claim when nothing higher applies. Secondary analysis can
            point to a primary record; it does not replace one.
          </p>

          <ol class="tier-list">
            {
              tiers.map((tier, index) => (
                <li class="tier">
                  <span class="tier__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="tier__content">
                    <h3>{tier.title}</h3>
                    <p>{tier.detail}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <p class="method-note">
            Every record keeps its access date, since pricing, limits, APIs, and policies change.
            Time-sensitive claims are rechecked before publishing and before any claim likely to
            have moved.
          </p>
        </section>

        <section id="record" class="method-section" aria-labelledby="record-title">
          <p class="eyebrow">05 · Corrections &amp; record</p>
          <h2 id="record-title">The record keeps its history</h2>
          <p class="method-lede">
            A correction is not a quiet edit. The URL stays stable, the change stays visible, and
            the reason it changed is part of the piece.
          </p>

          <div class="record-grid">
            <a href="/corrections" class="record-card">
              <span class="record-card__label">Corrections</span>
              <span class="record-card__title">How we correct the record</span>
              <span class="record-card__detail">
                What qualifies as a correction, how revision notes are written, and why retired
                pieces remain reachable.
              </span>
              <span class="record-card__link" aria-hidden="true">Read the policy →</span>
            </a>
            <a href="/editorial-policy" class="record-card">
              <span class="record-card__label">Review &amp; approval</span>
              <span class="record-card__title">How a piece gets published</span>
              <span class="record-card__detail">
                Readiness, review, and separate publication authorization, including the AI
                assistance rules.
              </span>
              <span class="record-card__link" aria-hidden="true">Read the policy →</span>
            </a>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .methodology-page {
    padding-block: var(--space-7) var(--space-9);
  }

  .methodology-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }

  .methodology-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .methodology-stat__value {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .methodology-stat__label {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .methodology-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .methodology-rail {
    min-width: 0;
  }

  .methodology-nav {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }

  .methodology-nav .eyebrow {
    margin: 0 0 var(--space-3);
  }

  .methodology-nav ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .methodology-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
  }

  .methodology-nav a span {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .methodology-nav a:hover,
  .methodology-nav a:focus-visible {
    border-color: var(--signal);
    color: var(--ink);
  }

  .rail-card {
    display: none;
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .rail-card .eyebrow {
    margin: 0 0 var(--space-3);
  }

  .rail-card--quiet {
    background: var(--surface-subtle);
  }

  .rail-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-links a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    line-height: 1.35;
    text-decoration: none;
  }

  .rail-links a span {
    color: var(--signal);
  }

  .rail-links a:hover {
    color: var(--signal);
  }

  .rail-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }

  .rail-facts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .rail-facts dt {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .rail-facts dd {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .method-section + .method-section {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--hairline);
  }

  .method-section > .eyebrow {
    margin: 0 0 var(--space-2);
  }

  .method-section h2 {
    max-width: 22ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.3rem + 1.1vw, 2.1rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .method-lede {
    max-width: 64ch;
    margin: var(--space-3) 0 0;
    color: var(--ink-muted);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .method-section h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
  }

  .chain-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .chain-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .chain-card__index {
    margin-bottom: var(--space-2);
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .chain-card__label {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .chain-card__detail {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .grade-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .grade-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .grade-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .grade-card__count {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }

  .grade-card > p {
    margin: var(--space-3) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .grade-card > .grade-card__rule {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--hairline);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  .method-callout {
    margin: var(--space-5) 0 0;
    padding: var(--space-4);
    border-left: 3px solid var(--signal);
    background: var(--surface-subtle);
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .gate-list {
    display: flex;
    flex-direction: column;
    margin: var(--space-5) 0 0;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    list-style: none;
    overflow: hidden;
  }

  .gate-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4);
    border-top: 1px solid var(--hairline);
  }

  .gate-item:first-child {
    border-top: 0;
  }

  .gate-item__index {
    flex-shrink: 0;
    padding-top: 0.1rem;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .gate-item p {
    margin: var(--space-1) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .method-note {
    margin: var(--space-4) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .method-note a {
    color: var(--signal);
  }

  .tier-list {
    margin: var(--space-5) 0 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
    list-style: none;
  }

  .tier {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }

  .tier__index {
    flex-shrink: 0;
    padding-top: 0.15rem;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .tier__content {
    min-width: 0;
  }

  .tier p {
    margin: var(--space-1) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .record-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .record-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }

  .record-card:hover,
  .record-card:focus-visible {
    border-color: var(--signal);
  }

  .record-card__label {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .record-card__title {
    margin-top: var(--space-2);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .record-card__detail {
    margin-top: var(--space-1);
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .record-card__link {
    margin-top: var(--space-4);
    color: var(--signal);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  @media (min-width: 40rem) {
    .chain-grid,
    .grade-grid,
    .record-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .methodology-page {
      padding-block: var(--space-8) var(--space-9);
    }

    .methodology-layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-7);
      margin-top: var(--space-8);
    }

    .methodology-rail {
      position: sticky;
      inset-block-start: 6rem;
      align-self: start;
    }

    .methodology-nav {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .methodology-nav ol {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: var(--space-1);
    }

    .methodology-nav a {
      inline-size: 100%;
      min-block-size: auto;
      padding: 0.35rem 0;
      border: 0;
      background: transparent;
      font-size: var(--text-sm);
    }

    .rail-card {
      display: block;
    }

    .methodology-rail {
      padding-right: var(--space-5);
      border-right: 1px solid var(--hairline);
    }
  }
</style>
