---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EvidenceStrip from '@/components/EvidenceStrip.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { getPublishedEntries } from '@/lib/publication';
import { evidenceCounts } from '@/lib/resolve';
import { buildEntryCards } from '@/lib/cards';
import { BUILD_TIME } from '@/lib/build-time';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  return sources.map((source) => ({ params: { slug: source.id }, props: { source } }));
}

const { source } = Astro.props;
const { title, url, publisher, published_at, accessed_at, source_type, primary, notes } =
  source.data;

const [articles, briefs] = await Promise.all([getCollection('articles'), getCollection('briefs')]);
const citing = getPublishedEntries([...articles, ...briefs], BUILD_TIME).filter((entry) => {
  const citedDirectly = entry.data.citations.some((reference) => reference.id === source.id);
  const citedByClaim = entry.data.claims.some((claim) =>
    claim.sources.some((reference) => reference.id === source.id),
  );
  return citedDirectly || citedByClaim;
});
const cards = await buildEntryCards(citing);
const citingEvidence = evidenceCounts(citing);
---

<BaseLayout
  title={title}
  description={`${title} - ${publisher}`}
  canonicalPath={`/sources/${source.id}`}
>
  <div class="source-detail shell">
    <PageHero
      eyebrow={`${source_type} · ${primary ? 'Primary source' : 'Secondary source'}`}
      title={title}
      description={notes ??
        `A ${source_type} published by ${publisher}, preserved with its access date and linked from the pieces that rely on it.`}
      backHref="/sources"
      backLabel="All sources"
    >
      <div slot="panel" class="source-panel">
        <dl class="source-facts">
          <div>
            <dt>Publisher</dt>
            <dd>{publisher}</dd>
          </div>
          <div>
            <dt>Type</dt>
            <dd class="source-facts__type">{source_type}</dd>
          </div>
          {
            published_at && (
              <div>
                <dt>Published</dt>
                <dd>{published_at.toISOString().slice(0, 10)}</dd>
              </div>
            )
          }
          <div>
            <dt>Accessed</dt>
            <dd>{accessed_at.toISOString().slice(0, 10)}</dd>
          </div>
        </dl>

        <a
          href={url}
          class="btn btn--primary source-panel__link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Open external source</span>
          <Icon name="external-link" size={14} />
        </a>
      </div>
    </PageHero>

    <div class="citing-grid">
      <section class="citing" aria-labelledby="citing-title">
        <div class="citing__head">
          <div>
            <p class="eyebrow">Citation Trail</p>
            <h2 id="citing-title" class="citing__title">
              Cited in {citing.length}{' '}
              {citing.length === 1 ? 'piece' : 'pieces'}
            </h2>
          </div>
          <span class="citing__count">{citing.length} live</span>
        </div>

        {
          cards.length === 0 ? (
            <p class="citing__empty">No live pieces cite this source yet.</p>
          ) : (
            <div class="citing__list">
              {cards.map((card) => (
                <ArticleCard {...card} headingLevel={3} />
              ))}
            </div>
          )
        }
      </section>

      <aside class="source-aside">
        {
          citing.length > 0 && (
            <div class="source-aside__card card">
              <EvidenceStrip counts={citingEvidence} label="Evidence in citing pieces" />
            </div>
          )
        }
        <div class="source-aside__card card">
          <p class="source-aside__label">Cite this source</p>
          <p class="source-aside__citation">
            {publisher}. “{title}.” Accessed {accessed_at.toISOString().slice(0, 10)}.
          </p>
          <a href={url} class="source-aside__url" target="_blank" rel="noopener noreferrer">
            {url}
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .source-detail {
    padding-block: var(--space-7) var(--space-9);
  }

  .source-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .source-facts dt,
  .source-facts dd {
    margin: 0;
  }

  .source-facts dt {
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .source-facts dd {
    margin-top: 0.15rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .source-facts__type {
    text-transform: capitalize;
  }

  .source-panel__link {
    margin-top: var(--space-4);
    width: 100%;
    justify-content: center;
  }

  .citing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    margin-top: var(--space-6);
  }

  .citing {
    min-width: 0;
    max-width: 56rem;
  }

  .citing__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--hairline);
  }

  .citing__title {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .citing__count {
    flex-shrink: 0;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .citing__empty {
    padding-block: var(--space-6);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .source-aside {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-4);
  }

  .source-aside__card {
    padding: var(--space-4);
  }

  .source-aside__label {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .source-aside__citation {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    overflow-wrap: anywhere;
  }

  .source-aside__url {
    display: block;
    margin-top: var(--space-2);
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .source-aside__url:hover {
    text-decoration: underline;
  }

  @media (min-width: 64rem) {
    .citing-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-7);
    }

    .citing {
      grid-column: span 8;
    }

    .source-aside {
      grid-column: span 4;
      position: sticky;
      top: 5.5rem;
      align-self: start;
    }
  }
</style>
