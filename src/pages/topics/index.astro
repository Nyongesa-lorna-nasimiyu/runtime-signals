---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import EvidenceStrip from '@/components/EvidenceStrip.astro';
import Icon from '@/components/Icon.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { evidenceCounts } from '@/lib/resolve';
import { BUILD_TIME } from '@/lib/build-time';

const [topics, articles, briefs] = await Promise.all([
  getCollection('topics'),
  getCollection('articles'),
  getCollection('briefs'),
]);
const live = getPublishedEntries([...articles, ...briefs], BUILD_TIME);

const topicCards = topics
  .slice()
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .map((topic, index) => {
    const entries = live.filter((entry) =>
      entry.data.topics.some((reference) => reference.id === topic.id),
    );
    return {
      topic,
      index,
      count: entries.length,
      evidence: evidenceCounts(entries),
    };
  });
---

<BaseLayout
  title="Topics"
  description="Core problem areas across production AI-agent engineering."
  canonicalPath="/topics"
>
  <div class="topics-page shell">
    <PageHero
      eyebrow="Domain Hubs"
      title="Topics"
      description="Core problem areas across production AI-agent engineering. Pillar hubs anchor recurring deep-dives; cross-cutting topics connect orchestration and state across boundaries."
    />

    <div class="topic-grid">
      {
        topicCards.map(({ topic, index, count, evidence }) => (
          <a href={`/topics/${topic.id}`} class="topic-card unstyled-link">
            <div class="topic-card__meta">
              <span>
                {String(index + 1).padStart(2, '0')} · {topic.data.pillar ? 'Pillar hub' : 'Domain'}
              </span>
              <span>{count} live</span>
            </div>

            <h2 class="topic-card__title">
              <span>{topic.data.name}</span>
              <Icon name="arrow-up-right" class="topic-card__arrow" />
            </h2>

            <p class="topic-card__description">{topic.data.description}</p>

            <div class="topic-card__footer">
              <span>Evidence profile</span>
              <EvidenceStrip counts={evidence} variant="mini" />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .topics-page {
    padding-block: var(--space-7) var(--space-9);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .topic-card {
    display: flex;
    min-width: 0;
    min-block-size: 17.25rem;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-5);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }

  .topic-card:hover,
  .topic-card:focus-visible {
    border-color: var(--signal);
  }

  .topic-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .topic-card__meta span:first-child {
    color: var(--signal);
  }

  .topic-card__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .topic-card__arrow {
    flex-shrink: 0;
    color: var(--ink-muted);
    opacity: 0.5;
  }

  .topic-card:hover .topic-card__title {
    color: var(--signal);
  }

  .topic-card:hover .topic-card__arrow {
    color: var(--signal);
    opacity: 1;
  }

  .topic-card__description {
    margin: var(--space-2) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .topic-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
  }

  .topic-card__footer > span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .topic-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .topic-card {
      min-block-size: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .topic-card,
    .topic-card__title,
    .topic-card__arrow {
      transition:
        border-color var(--motion-duration-fast) var(--motion-ease-out),
        color var(--motion-duration-fast) var(--motion-ease-out),
        opacity var(--motion-duration-fast) var(--motion-ease-out);
    }
  }
</style>
