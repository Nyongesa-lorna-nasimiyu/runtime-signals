---
// The signature element: a real strip-chart rendered from the site's actual
// claim-evidence tally (src/lib/resolve.ts's evidenceCounts), not a decorative
// stand-in for it. `channels` (the hero, one row per evidence grade with its
// share of the total) is the large, memorable form; `mini` (article cards) is
// the same data collapsed to one segmented bar so a reader can see a piece's
// own evidence mix before opening it.
import type { EvidenceStrength } from '@/lib/resolve';

interface Props {
  counts: Record<EvidenceStrength, number>;
  variant?: 'channels' | 'mini';
  label?: string;
  class?: string;
}

const ORDER: EvidenceStrength[] = ['supported', 'mixed', 'inference', 'opinion'];

const { counts, variant = 'channels', label, class: className = '' } = Astro.props;

const total = ORDER.reduce((sum, key) => sum + counts[key], 0);

let offset = 0;
const rows = ORDER.map((evidence) => {
  const count = counts[evidence];
  const row = {
    evidence,
    count,
    offset,
    pct: total === 0 ? 0 : Math.round((count / total) * 100),
  };
  offset += count;
  return row;
});

const summary =
  total === 0
    ? 'No claims tracked yet.'
    : `Evidence mix: ${rows
        .filter((r) => r.count > 0)
        .map((r) => `${r.pct}% ${r.evidence}`)
        .join(', ')} (${total} claim${total === 1 ? '' : 's'}).`;
---

{
  variant === 'channels' ? (
    <div class:list={['evidence-strip', className]} role="img" aria-label={summary}>
      {label && <p class="evidence-strip__label eyebrow">{label}</p>}
      <div class="evidence-strip__channels" aria-hidden="true">
        {rows.map((row) => (
          <div class="evidence-strip__channel">
            <span class="evidence-strip__name" data-evidence={row.evidence}>
              {row.evidence}
            </span>
            <svg
              class="evidence-strip__track"
              viewBox="0 0 100 1"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <rect
                class="evidence-strip__fill"
                data-evidence={row.evidence}
                width={row.pct}
                height="1"
                rx="0.1"
              />
            </svg>
            <span class="evidence-strip__pct">{row.pct}%</span>
          </div>
        ))}
      </div>
    </div>
  ) : (
    <span
      class:list={['evidence-strip evidence-strip--mini', className]}
      role="img"
      aria-label={summary}
    >
      <svg
        class="evidence-strip__bar"
        viewBox={`0 0 ${Math.max(total, 1)} 1`}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        {rows
          .filter((row) => row.count > 0)
          .map((row) => (
            <rect
              class="evidence-strip__segment"
              data-evidence={row.evidence}
              x={row.offset}
              width={row.count}
              height="1"
            />
          ))}
      </svg>
    </span>
  )
}

<style>
  .evidence-strip__label {
    margin: 0 0 var(--space-3);
  }

  .evidence-strip__channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .evidence-strip__channel {
    display: grid;
    grid-template-columns: 6.5rem 1fr 2.5rem;
    align-items: center;
    gap: var(--space-3);
  }

  .evidence-strip__name {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .evidence-strip__track {
    display: block;
    width: 100%;
    height: 0.6rem;
    background: var(--hairline);
    border-radius: 1px;
    overflow: hidden;
  }

  .evidence-strip__fill {
    fill: var(--ink-muted);
  }

  .evidence-strip__fill[data-evidence='supported'] {
    fill: var(--evidence-supported);
  }
  .evidence-strip__fill[data-evidence='mixed'] {
    fill: var(--evidence-mixed);
  }
  .evidence-strip__fill[data-evidence='inference'] {
    fill: var(--evidence-inference);
  }
  .evidence-strip__fill[data-evidence='opinion'] {
    fill: var(--evidence-opinion);
  }

  .evidence-strip__pct {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
    text-align: right;
  }

  /* Mini: a single segmented bar for one entry's own claim mix, sized to sit
     inline with the card meta row it lives in. */
  .evidence-strip--mini {
    display: inline-block;
    width: 3.5rem;
    vertical-align: middle;
  }

  .evidence-strip__bar {
    display: block;
    width: 100%;
    height: 0.35rem;
    border-radius: 1px;
    overflow: hidden;
    background: var(--hairline);
  }

  .evidence-strip__segment[data-evidence='supported'] {
    fill: var(--evidence-supported);
  }
  .evidence-strip__segment[data-evidence='mixed'] {
    fill: var(--evidence-mixed);
  }
  .evidence-strip__segment[data-evidence='inference'] {
    fill: var(--evidence-inference);
  }
  .evidence-strip__segment[data-evidence='opinion'] {
    fill: var(--evidence-opinion);
  }
</style>
