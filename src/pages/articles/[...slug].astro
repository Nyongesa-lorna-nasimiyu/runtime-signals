---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getRoutableEntries, isArchived } from '@/lib/publication';
import { resolveAuthorNames, resolveTopicNames, resolveSeries } from '@/lib/resolve';
import { getEntries } from 'astro:content';
import { Callout, Figure } from '@/components/mdx';
import { BUILD_TIME } from '@/lib/build-time';

// This is the actual draft/future/unapproved exclusion boundary: getStaticPaths only
// ever iterates getRoutableEntries(), so a draft, a not-yet-due scheduled piece, or
// an unapproved commit is never given a route at all - not filtered from a listing,
// genuinely absent as a URL. Proven against the real dist/ output by
// scripts/verify-draft-exclusion.mjs (a black-box check, not a mock - see
// tests/integration/README.md for why this isn't a vitest integration test).
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const routable = getRoutableEntries(articles, BUILD_TIME);
  return routable.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const [authorNames, topicNames, series, sourceEntries, artifactEntries] = await Promise.all([
  resolveAuthorNames(entry),
  resolveTopicNames(entry),
  resolveSeries(entry),
  getEntries(entry.data.citations),
  getEntries(entry.data.artifacts),
]);
const sourceTitles = sourceEntries.map((s) => ({ id: s.id, title: s.data.title, url: s.data.url }));
const artifactTitles = artifactEntries.map((a) => ({
  id: a.id,
  title: a.data.title,
  url: a.data.url,
  kind: a.data.kind,
}));
---

<ArticleLayout
  entry={entry}
  authorNames={authorNames}
  topicNames={topicNames}
  series={series}
  sourceTitles={sourceTitles}
  artifactTitles={artifactTitles}
  archived={isArchived(entry)}
  bodyHeadings={headings}
>
  <Content components={{ Callout, Figure }} />
</ArticleLayout>
