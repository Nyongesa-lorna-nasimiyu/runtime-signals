{
  // Production deployment runs through the protected `production` GitHub
  // environment in `.github/workflows/deploy.yml`. Validate locally with
  // `npm run wrangler:dry-run` (wrangler deploy --dry-run), which never publishes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runtime-signals",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    // Wrangler 4.127.1 does not support a redact_query_string key here.
    // Keep query-string redaction in the application/security policy until
    // Cloudflare exposes a supported configuration field.
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Astro always emits directory-style output (e.g. articles/index.html)
    // regardless of astro.config.mjs's trailingSlash setting - that setting
    // only controls Astro's own canonical/sitemap/internal-link generation,
    // which is no-slash ("never"). Without this, Workers Static Assets'
    // default html_handling ("auto-trailing-slash") treats every route as a
    // folder and 307-redirects the no-slash URL to a slash URL, fighting the
    // canonical convention every internal link and the sitemap already use.
    "html_handling": "drop-trailing-slash"
  }
}
