---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getPublishedEntries } from '@/lib/publication';
import { resolveTopicNames, weakestEvidence, articlePath } from '@/lib/resolve';
import { BUILD_TIME } from '@/lib/build-time';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({ params: { slug: topic.id }, props: { topic } }));
}

const { topic } = Astro.props;
const [articles, briefs] = await Promise.all([getCollection('articles'), getCollection('briefs')]);
const live = getPublishedEntries([...articles, ...briefs], BUILD_TIME).filter((entry) =>
  entry.data.topics.some((ref) => ref.id === topic.id),
);
const cards = await Promise.all(
  live.map(async (entry) => ({
    id: entry.id,
    path: articlePath(entry),
    title: entry.data.title,
    dek: entry.data.dek,
    publishedAt: entry.data.published_at,
    topics: await resolveTopicNames(entry),
    dominantEvidence: weakestEvidence(entry),
  })),
);
---

<BaseLayout
  title={topic.data.name}
  description={topic.data.description}
  canonicalPath={`/topics/${topic.id}`}
>
  <section class="listing">
    <header class="listing__header">
      <p class="eyebrow">Topic</p>
      <h1>{topic.data.name}</h1>
      <p class="listing__intro">{topic.data.description}</p>
    </header>
    {
      cards.length === 0 ? (
        <p class="listing__empty">No published pieces in this topic yet.</p>
      ) : (
        <div class="listing__list">
          {cards.map((card) => (
            <ArticleCard {...card} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .listing {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }
  .listing__header h1 {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-2);
  }
  .listing__intro {
    color: var(--ink-muted);
    max-width: 60ch;
    margin: 0 0 var(--space-6);
  }
  .listing__empty {
    color: var(--ink-muted);
  }
</style>
