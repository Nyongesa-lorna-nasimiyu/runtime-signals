---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { absoluteUrl, websiteJsonLd } from '@/lib/seo';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  jsonLd?: object[];
  ogImagePath?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  jsonLd = [],
  ogImagePath = '/og-default.png',
  ogType = 'website',
} = Astro.props;
const canonical = absoluteUrl(canonicalPath);
const ogImage = absoluteUrl(ogImagePath);
const allJsonLd = [websiteJsonLd(), ...jsonLd];
// A PR preview build (.github/workflows/pr-preview.yml, PREVIEW_BUILD=true)
// must never be indexable regardless of what any individual page's own
// noindex prop says - it's showing content at a commit that hasn't gone
// through review yet. Read via process.env, not import.meta.env, matching
// src/lib/build-time.ts and src/lib/og-image.ts's SKIP_OG_RENDER - this runs
// server-side at build time, and process.env is the value actually set by
// the workflow's `env:` block.
// See src/pages/robots.txt.ts for the matching site-wide Disallow.
const isPreviewBuild = process.env.PREVIEW_BUILD === 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - Runtime Signals</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isPreviewBuild) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Runtime Signals" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title="Runtime Signals" href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="Runtime Signals" href="/atom.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Above-the-fold on every page (masthead, nav, hero) - preloaded per web
         performance guidance; crossorigin is required even for same-origin fonts. -->
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Class-based Prism theme, not Shiki's inline styles - see astro.config.mjs. -->
    <link rel="stylesheet" href="/prism-theme.css" />

    {
      allJsonLd.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <!-- data-pagefind-body scopes indexing to real content, site-wide, so header
         nav and footer chrome are never indexed - the gap an external review
         caught (Pagefind had been indexing whole pages with 0 filters). -->
    <!-- tabindex="-1": the skip link's target must be programmatically focusable
         or clicking it scrolls here without actually moving keyboard focus, so
         the next Tab press resumes from the skip link instead of from here. -->
    <main id="main" data-pagefind-body tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
