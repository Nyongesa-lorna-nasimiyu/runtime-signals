---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const authors = (await getCollection('authors')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<BaseLayout
  title="Authors"
  description="Runtime Signals authors and their disclosures."
  canonicalPath="/authors"
>
  <section class="listing">
    <header class="listing__header">
      <p class="eyebrow">Bylines</p>
      <h1>Authors</h1>
    </header>
    <ul class="author-list">
      {
        authors.map((author) => (
          <li>
            <a href={`/authors/${author.id}`} class="unstyled-link author-list__item">
              <span class="author-list__name">{author.data.name}</span>
              <span class="author-list__bio">{author.data.bio}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .listing {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }
  .listing__header h1 {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-6);
  }
  .author-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .author-list__item {
    display: block;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--hairline);
    color: inherit;
  }
  .author-list__name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .author-list__bio {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
