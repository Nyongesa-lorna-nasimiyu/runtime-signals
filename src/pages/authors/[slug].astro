---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EvidenceStrip from '@/components/EvidenceStrip.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import { getPublishedEntries } from '@/lib/publication';
import { evidenceCounts } from '@/lib/resolve';
import { buildEntryCards } from '@/lib/cards';
import { profilePageJsonLd } from '@/lib/seo';
import { BUILD_TIME } from '@/lib/build-time';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { slug: author.id }, props: { author } }));
}

const { author } = Astro.props;
const [articles, briefs] = await Promise.all([getCollection('articles'), getCollection('briefs')]);
const live = getPublishedEntries([...articles, ...briefs], BUILD_TIME).filter((entry) =>
  entry.data.authors.some((reference) => reference.id === author.id),
);
const cards = await buildEntryCards(live);
const authoredEvidence = evidenceCounts(live);
const jsonLd = [
  profilePageJsonLd({
    name: author.data.name,
    bio: author.data.bio,
    path: `/authors/${author.id}`,
  }),
];
---

<BaseLayout
  title={author.data.name}
  description={author.data.bio}
  canonicalPath={`/authors/${author.id}`}
  jsonLd={jsonLd}
>
  <div class="author-page shell">
    <PageHero
      eyebrow="Contributor"
      title={author.data.name}
      description={author.data.bio}
      backHref="/authors"
      backLabel="All authors"
    >
      <div slot="panel" class="author-panel">
        {
          author.data.expertise.length > 0 && (
            <div class="author-panel__section">
              <p class="author-panel__label">Focus</p>
              <p class="author-panel__expertise">{author.data.expertise.join(' · ')}</p>
            </div>
          )
        }

        {
          live.length > 0 && (
            <div class="author-panel__section">
              <EvidenceStrip counts={authoredEvidence} label="Evidence across authored pieces" />
            </div>
          )
        }

        {
          author.data.links.length > 0 && (
            <div class="author-panel__section author-panel__links">
              {author.data.links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  <span>{link.label}</span>
                  <Icon name="external-link" size={12} />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </PageHero>

    {
      author.data.disclosure && (
        <div class="author-disclosure" role="note">
          <Icon name="alert-triangle" class="author-disclosure__icon" />
          <p>
            <strong>Disclosure:</strong> {author.data.disclosure}
          </p>
        </div>
      )
    }

    <section class="author-pieces" aria-labelledby="author-pieces-title">
      <div class="author-pieces__head">
        <h2 id="author-pieces-title">
          Published pieces ({live.length})
        </h2>
        <span>{live.length} live</span>
      </div>

      {
        cards.length === 0 ? (
          <p class="author-pieces__empty">No published pieces yet.</p>
        ) : (
          <div class="author-pieces__list">
            {cards.map((card) => (
              <ArticleCard {...card} headingLevel={3} />
            ))}
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .author-page {
    padding-block: var(--space-7) var(--space-9);
  }

  .author-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .author-panel__section + .author-panel__section {
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
  }

  .author-panel__label {
    margin: 0 0 var(--space-1);
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .author-panel__expertise {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .author-panel__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .author-panel__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--signal);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
  }

  .author-panel__links a:hover {
    text-decoration: underline;
  }

  .author-disclosure {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--evidence-mixed) 45%, var(--hairline));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--evidence-mixed) 8%, var(--surface));
  }

  .author-disclosure__icon {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--evidence-mixed);
  }

  .author-disclosure p {
    margin: 0;
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .author-disclosure strong {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .author-pieces {
    max-width: 56rem;
    margin-top: var(--space-6);
  }

  .author-pieces__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--hairline);
  }

  .author-pieces__head h2 {
    margin: 0;
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .author-pieces__head span {
    flex-shrink: 0;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .author-pieces__empty {
    padding-block: var(--space-6);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
