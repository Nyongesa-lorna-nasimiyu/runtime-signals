---
import type { CollectionEntry } from 'astro:content';
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { BUILD_TIME } from '@/lib/build-time';

type Editorial = CollectionEntry<'articles'> | CollectionEntry<'briefs'>;

interface Props {
  entries: CollectionEntry<'articles'>[];
  allEntries: Editorial[];
  currentPage: number;
  totalPages: number;
}

export async function getStaticPaths() {
  const PAGE_SIZE = 10;
  const articles = await getCollection('articles');
  const live = getPublishedEntries(articles, BUILD_TIME);
  const totalPages = Math.ceil(live.length / PAGE_SIZE);

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: {
        entries: live.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE),
        allEntries: live,
        currentPage,
        totalPages,
      },
    };
  });
}

const { entries, allEntries, currentPage, totalPages } = Astro.props;
---

<ArchiveLayout
  entries={entries}
  allEntries={allEntries}
  title={`Articles - Page ${currentPage}`}
  eyebrow="Long-Form Investigations"
  description="Deep-dives, architectural patterns, and tutorials tracing production failure mechanisms, formal runtime invariants, and verified engineering practices."
  canonicalPath={`/articles/page/${currentPage}`}
  basePath="/articles"
  currentPage={currentPage}
  totalPages={totalPages}
  showKindFilter
  emptyMessage="No published articles yet."
/>
