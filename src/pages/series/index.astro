---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { BUILD_TIME } from '@/lib/build-time';

const [series, articles, briefs] = await Promise.all([
  getCollection('series'),
  getCollection('articles'),
  getCollection('briefs'),
]);
const sortedSeries = series.slice().sort((a, b) => a.data.name.localeCompare(b.data.name));
const live = getPublishedEntries([...articles, ...briefs], BUILD_TIME);
const ids = new Set(live.map((entry) => entry.id));

const seriesCards = sortedSeries.map((item) => ({
  series: item,
  liveParts: item.data.order.filter((reference) => ids.has(reference.id)).length,
}));
const totalParts = seriesCards.reduce((sum, item) => sum + item.liveParts, 0);
---

<BaseLayout
  title="Series"
  description="Ordered reading tracks connecting failure invariants, implementation tutorials, and state transfer contracts."
  canonicalPath="/series"
>
  <div class="series-page shell">
    <PageHero
      eyebrow="Curated Sequences"
      title="Series"
      description="Ordered reading tracks connecting failure invariants, implementation tutorials, and state transfer contracts."
    >
      <div slot="panel" class="series-stats">
        <div>
          <span class="series-stats__value">{seriesCards.length}</span>
          <span class="series-stats__label">Reading sequences</span>
        </div>
        <div>
          <span class="series-stats__value">{totalParts}</span>
          <span class="series-stats__label">Live parts</span>
        </div>
      </div>
    </PageHero>

    <div class="series-grid">
      {
        seriesCards.map(({ series: item, liveParts }) => (
          <a href={`/series/${item.id}`} class="series-card unstyled-link">
            <p class="series-card__meta">{liveParts} parts in sequence</p>
            <h2 class="series-card__title">
              <span>{item.data.name}</span>
              <Icon name="arrow-up-right" class="series-card__arrow" />
            </h2>
            <p class="series-card__description">{item.data.description}</p>
            <span class="series-card__cta">
              Open reading track
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .series-page {
    padding-block: var(--space-7) var(--space-9);
  }

  .series-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .series-stats > div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .series-stats__value {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .series-stats__label {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .series-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .series-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: var(--space-5);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
  }

  .series-card:hover,
  .series-card:focus-visible {
    border-color: var(--signal);
  }

  .series-card__meta {
    margin: 0;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .series-card__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .series-card:hover .series-card__title {
    color: var(--signal);
  }

  .series-card__arrow {
    flex-shrink: 0;
    color: var(--ink-muted);
    opacity: 0.5;
  }

  .series-card:hover .series-card__arrow {
    color: var(--signal);
    opacity: 1;
  }

  .series-card__description {
    margin: var(--space-2) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .series-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
    color: var(--signal);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .series-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .series-card,
    .series-card__title,
    .series-card__arrow {
      transition:
        border-color var(--motion-duration-fast) var(--motion-ease-out),
        color var(--motion-duration-fast) var(--motion-ease-out),
        opacity var(--motion-duration-fast) var(--motion-ease-out);
    }
  }
</style>
