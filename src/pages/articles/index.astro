---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { resolveTopicNames, weakestEvidence, articlePath } from '@/lib/resolve';
import { BUILD_TIME } from '@/lib/build-time';

const articles = await getCollection('articles');
const live = getPublishedEntries(articles, BUILD_TIME);
const cards = await Promise.all(
  live.map(async (entry) => ({
    id: entry.id,
    path: articlePath(entry),
    title: entry.data.title,
    dek: entry.data.dek,
    publishedAt: entry.data.published_at,
    topics: await resolveTopicNames(entry),
    dominantEvidence: weakestEvidence(entry),
  })),
);
---

<BaseLayout
  title="Articles"
  description="All published Runtime Signals articles, filterable by topic and evidence strength."
  canonicalPath="/articles"
>
  <section class="listing">
    <header class="listing__header">
      <p class="eyebrow">Archive</p>
      <h1>Articles</h1>
    </header>
    {
      cards.length === 0 ? (
        <p class="listing__empty">No published articles yet.</p>
      ) : (
        <div class="listing__list">
          {cards.map((card) => (
            <ArticleCard {...card} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .listing {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }
  .listing__header h1 {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-6);
  }
  .listing__empty {
    color: var(--ink-muted);
  }
</style>
