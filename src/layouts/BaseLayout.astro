---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { absoluteUrl, websiteJsonLd } from '@/lib/seo';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const { title, description, canonicalPath, noindex = false, jsonLd = [] } = Astro.props;
const canonical = absoluteUrl(canonicalPath);
const allJsonLd = [websiteJsonLd(), ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Runtime Signals</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Runtime Signals" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title="Runtime Signals" href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="Runtime Signals" href="/atom.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      allJsonLd.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <!-- data-pagefind-body scopes indexing to real content, site-wide, so header
         nav and footer chrome are never indexed — the gap an external review
         caught (Pagefind had been indexing whole pages with 0 filters). -->
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
