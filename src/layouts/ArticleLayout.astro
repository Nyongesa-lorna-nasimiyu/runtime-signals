---
import BaseLayout from './BaseLayout.astro';
import EvidenceTag from '@/components/EvidenceTag.astro';
import EvidenceStrip from '@/components/EvidenceStrip.astro';
import Icon from '@/components/Icon.astro';
import RelatedContent from '@/components/RelatedContent.astro';
import { articleJsonLd, breadcrumbJsonLd } from '@/lib/seo';
import {
  latestRevisionDate,
  evidenceCounts,
  type SourceSummary,
  type ArtifactSummary,
} from '@/lib/resolve';
import { artworkForTopics } from '@/lib/illustration';
import { spanId } from '@/lib/span-id';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  entry: CollectionEntry<'articles'> | CollectionEntry<'briefs'>;
  authorNames: string[];
  topicItems: { id: string; name: string }[];
  series?: { id: string; name: string }[];
  sources: SourceSummary[];
  artifacts: ArtifactSummary[];
  archived: boolean;
  relatedContent?: {
    curated: CollectionEntry<'articles'>[];
    seriesNext?: CollectionEntry<'articles'>;
    fallback: CollectionEntry<'articles'>[];
  };
  bodyHeadings?: MarkdownHeading[];
}

const {
  entry,
  authorNames,
  topicItems,
  series = [],
  sources,
  artifacts,
  archived,
  relatedContent,
  bodyHeadings = [],
} = Astro.props;

const { title, dek, published_at, revisions, claims, seo } = entry.data;
const entryEvidence = evidenceCounts([entry]);
const path = entry.collection === 'articles' ? `/articles/${entry.id}` : `/brief/${entry.id}`;
const sectionLabel = entry.collection === 'articles' ? 'Articles' : 'Brief';
const lastRevised = latestRevisionDate(entry);
const readingTimeMinutes = entry.data.reading_time_minutes;
const wordCount = entry.body
  ? entry.body.trim().split(/\s+/).filter(Boolean).length
  : readingTimeMinutes * 200;
const artwork = artworkForTopics(entry.data.topics.map((topic) => topic.id));

const kindLabel =
  entry.collection === 'briefs'
    ? 'Brief'
    : entry.data.kind === 'deep-dive'
      ? 'Deep-dive'
      : entry.data.kind === 'tutorial'
        ? 'Tutorial'
        : entry.data.kind === 'case-study'
          ? 'Case study'
          : 'Article';

const authorItems = entry.data.authors.map((author, index) => ({
  id: author.id,
  name: authorNames[index] ?? author.id,
}));

const corrections = revisions.filter((revision) => revision.type === 'correction');

const ogImagePath = `/og/${entry.collection === 'articles' ? 'articles' : 'brief'}/${entry.id}.png?v=${lastRevised.getTime()}`;
const citationUrl = new URL(path, Astro.site ?? 'https://runtimesignals.tech').href;
const citation = `${authorNames.join(', ')} (${published_at.getFullYear()}). ${title}. Runtime Signals. ${citationUrl}`;

const sourceById = new Map(sources.map((source) => [source.id, source]));
const claimsWithSources = claims.map((claim) => ({
  ...claim,
  sourceItems: claim.sources
    .map((reference) => sourceById.get(reference.id))
    .filter((source): source is SourceSummary => source !== undefined),
}));

const railSections = [
  ...bodyHeadings
    .filter((heading) => heading.depth === 2)
    .map((heading) => ({
      id: heading.slug,
      label: heading.text,
    })),
  ...(claims.length > 0 ? [{ id: 'claims-heading', label: 'Graded claims' }] : []),
  ...(revisions.length > 0 ? [{ id: 'revision-history', label: 'Revision history' }] : []),
  ...(artifacts.length > 0 ? [{ id: 'artifacts-heading', label: 'Artifacts' }] : []),
  ...(sources.length > 0 ? [{ id: 'sources-heading', label: 'Sources' }] : []),
];

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: sectionLabel, path: entry.collection === 'articles' ? '/articles' : '/brief' },
    { name: title, path },
  ]),
  articleJsonLd({
    title,
    description: seo.description ?? dek,
    path,
    publishedAt: published_at,
    updatedAt: lastRevised,
    authorNames,
    imagePath: ogImagePath,
  }),
];
---

<BaseLayout
  title={seo.title ?? title}
  description={seo.description ?? dek}
  canonicalPath={path}
  noindex={seo.noindex || archived}
  jsonLd={jsonLd}
  ogImagePath={ogImagePath}
  ogType="article"
>
  <div
    class="reading-progress no-print"
    role="progressbar"
    aria-label="Article reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    data-reading-progress
  >
    <div class="reading-progress__fill" data-reading-progress-fill></div>
  </div>

  <div class="article-page shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href={entry.collection === 'articles' ? '/articles' : '/brief'}>{sectionLabel}</a>
      <span aria-hidden="true">/</span>
      <span class="breadcrumb__current">{spanId(entry.id)}</span>
    </nav>

    {
      archived && (
        <div class="notice article__archived-notice" role="note">
          <Icon name="archive" class="notice__icon" />
          <p>
            <strong>Archived entry:</strong> This piece is preserved at its original URL for
            reference, but has been retired from active feeds and search.
          </p>
        </div>
      )
    }

    {
      corrections.length > 0 && (
        <div class="notice article__correction-notice" role="note">
          <Icon name="alert-triangle" class="notice__icon" />
          <p>
            <strong>Corrections issued ({corrections.length}):</strong> See{' '}
            <a href="#revision-history">revision history</a> for what changed and why.
          </p>
        </div>
      )
    }

    <div class="article-grid">
      <article
        class="article"
        data-slug={entry.id}
        data-topics={JSON.stringify(topicItems.map((topic) => topic.name))}
      >
        <header class="article__header">
          <div class="article__meta-row">
            <span class="article__kind">{kindLabel}</span>
            {
              topicItems.map((topic) => (
                <>
                  <span aria-hidden="true">·</span>
                  <a href={`/topics/${topic.id}`} data-pagefind-filter="topic">
                    {topic.name}
                  </a>
                </>
              ))
            }
            <span aria-hidden="true">·</span>
            <span
              class="article__reading-time"
              title={`${wordCount.toLocaleString()} words at 200 words/min`}
            >
              {readingTimeMinutes} min read
            </span>
            <span aria-hidden="true">·</span>
            <span class="span-id" aria-hidden="true">{spanId(entry.id)}</span>
          </div>

          <h1 class="article__title">{title}</h1>
          <p class="article__dek">{dek}</p>

          <div class="article__byline-row">
            <div class="article__byline">
              <span>
                By{' '}
                {
                  authorItems.map((author, index) => (
                    <>
                      {index > 0 && ', '}
                      <a href={`/authors/${author.id}`} data-pagefind-filter="author">
                        {author.name}
                      </a>
                    </>
                  ))
                }
              </span>
              <span aria-hidden="true">·</span>
              <time datetime={published_at.toISOString()} data-pagefind-filter="date[datetime]">
                Published {published_at.toISOString().slice(0, 10)}
              </time>
              {
                revisions.length > 0 && (
                  <>
                    <span aria-hidden="true">·</span>
                    <a href="#revision-history">
                      {corrections.length > 0 ? 'Corrected' : 'Updated'}{' '}
                      {lastRevised.toISOString().slice(0, 10)}
                    </a>
                  </>
                )
              }
            </div>

            <button
              type="button"
              class="reading-mode no-print"
              data-reading-cycle
              data-reading-mode="standard"
              aria-label="Reading mode: Standard. Activate to change text size."
            >
              <Icon name="book-open" />
              <span data-reading-mode-label>Reading Mode: Standard</span>
            </button>
          </div>

          {
            series.length > 0 && (
              <p class="article__series">
                Series:{' '}
                {series.map((item, index) => (
                  <>
                    {index > 0 && ', '}
                    <a href={`/series/${item.id}`} data-pagefind-filter="series">
                      {item.name}
                    </a>
                  </>
                ))}
              </p>
            )
          }
        </header>

        {
          (railSections.length > 1 || claims.length > 0) && (
            <details class="mobile-article-drawer no-print">
              <summary>
                <span>
                  Sections &amp; evidence (<span data-progress-label>0% read</span>)
                </span>
                <Icon name="chevron-down" class="mobile-article-drawer__chevron" />
              </summary>
              <div class="mobile-article-drawer__body">
                {claims.length > 0 && (
                  <EvidenceStrip counts={entryEvidence} label="Piece evidence profile" />
                )}
                {railSections.length > 1 && (
                  <nav aria-label="Mobile article sections">
                    <ol class="toc-list">
                      {railSections.map((section) => (
                        <li>
                          <a href={`#${section.id}`} data-toc-link>
                            {section.label}
                          </a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                )}
              </div>
            </details>
          )
        }

        <figure class="article__art">
          <img
            src={artwork.src}
            width={artwork.width}
            height={artwork.height}
            alt={`Architectural schematic accompanying ${title}`}
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="article__body" data-article-body data-size="standard">
          <slot />
        </div>

        {
          claims.length > 0 && (
            <section class="article__section" id="claims-heading" aria-labelledby="claims-title">
              <div class="section-heading">
                <div>
                  <p class="eyebrow eyebrow--signal">Claim Verification Ledger</p>
                  <h2 id="claims-title" class="section-heading__title">
                    Graded assertions ({claims.length})
                  </h2>
                  <p class="section-heading__note" data-claim-count>
                    Showing all {claims.length}
                  </p>
                </div>

                <div
                  class="claim-filters no-print"
                  role="group"
                  aria-label="Filter claims by evidence"
                >
                  {(['all', 'supported', 'mixed', 'inference', 'opinion'] as const).map((grade) => (
                    <button
                      type="button"
                      data-claim-filter={grade}
                      class:list={['claim-filter', { 'claim-filter--active': grade === 'all' }]}
                      aria-pressed={grade === 'all' ? 'true' : 'false'}
                    >
                      {grade}
                    </button>
                  ))}
                </div>
              </div>

              <div class="claim-list">
                {claimsWithSources.map((claim) => (
                  <article
                    class="claim-card"
                    data-claim
                    data-evidence={claim.evidence}
                    id={`claim-${claim.id}`}
                  >
                    <div class="claim-card__top">
                      <span class="span-id">{claim.id}</span>
                      <EvidenceTag evidence={claim.evidence} />
                    </div>
                    <p class="claim-card__text">{claim.text}</p>
                    {claim.sourceItems.length > 0 && (
                      <div class="claim-card__sources">
                        <span class="claim-card__sources-label">Sources</span>
                        {claim.sourceItems.map((source) => (
                          <a href={`#source-${source.id}`} data-source-link={source.id}>
                            {source.title}
                          </a>
                        ))}
                      </div>
                    )}
                  </article>
                ))}
              </div>
              <p class="claim-empty" data-claim-empty hidden>
                No graded claims match that evidence level.
              </p>
            </section>
          )
        }

        {
          revisions.length > 0 && (
            <section
              class="article__section"
              id="revision-history"
              aria-labelledby="revisions-title"
            >
              <p class="eyebrow">Editorial Audit Trail</p>
              <h2 id="revisions-title" class="section-heading__title">
                Revision history
              </h2>
              <ol class="revision-list">
                {[...revisions]
                  .sort((a, b) => b.date.getTime() - a.date.getTime())
                  .map((revision) => (
                    <li>
                      <div class="revision-list__meta">
                        <time datetime={revision.date.toISOString()}>
                          {revision.date.toISOString().slice(0, 10)}
                        </time>
                        <span aria-hidden="true">·</span>
                        <span class="revision-badge" data-type={revision.type}>
                          {revision.type}
                        </span>
                      </div>
                      <p>{revision.note}</p>
                    </li>
                  ))}
                <li class="revision-list__initial">
                  <div class="revision-list__meta">
                    <time datetime={published_at.toISOString()}>
                      {published_at.toISOString().slice(0, 10)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span class="revision-badge" data-type="published">
                      published
                    </span>
                  </div>
                  <p>Initial approved publication.</p>
                </li>
              </ol>
            </section>
          )
        }

        {
          artifacts.length > 0 && (
            <section
              class="article__section"
              id="artifacts-heading"
              aria-labelledby="artifacts-title"
            >
              <p class="eyebrow">Reproducible Code &amp; Datasets</p>
              <h2 id="artifacts-title" class="section-heading__title">
                Companion artifacts
              </h2>
              <div class="artifact-grid">
                {artifacts.map((artifact) => (
                  <a
                    href={artifact.url}
                    class="artifact-card card"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-artifact-id={artifact.id}
                  >
                    <div class="artifact-card__top">
                      <span>{artifact.kind}</span>
                      <Icon name="external-link" size={14} />
                    </div>
                    <h3>{artifact.title}</h3>
                    <p>{artifact.description}</p>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {
          sources.length > 0 && (
            <section class="article__section" id="sources-heading" aria-labelledby="sources-title">
              <p class="eyebrow">Primary &amp; Secondary Evidence</p>
              <h2 id="sources-title" class="section-heading__title">
                Sources ({sources.length})
              </h2>
              <ul class="source-list">
                {sources.map((source) => (
                  <li class="source-card" id={`source-${source.id}`} data-source-id={source.id}>
                    <div class="source-card__meta">
                      <span class="source-card__type">{source.sourceType}</span>
                      <span aria-hidden="true">·</span>
                      <span>{source.primary ? 'Primary source' : 'Secondary source'}</span>
                      <span aria-hidden="true">·</span>
                      <span>{source.publisher}</span>
                      <span aria-hidden="true">·</span>
                      <span>Accessed {source.accessedAt.toISOString().slice(0, 10)}</span>
                    </div>
                    <div class="source-card__title-row">
                      <a href={`/sources/${source.id}`} class="source-card__title">
                        {source.title}
                      </a>
                      <a
                        href={source.url}
                        class="source-card__external"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span>External URL</span>
                        <Icon name="external-link" size={12} />
                      </a>
                    </div>
                    {source.notes && <p class="source-card__notes">{source.notes}</p>}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <RelatedContent relatedContent={relatedContent} />
      </article>

      <aside class="article__rail no-print">
        <div class="rail-sticky">
          <div class="rail-card card">
            <div class="rail-row">
              <span class="rail-row__label">Reading progress</span>
              <span class="rail-row__value rail-row__value--signal" data-progress-percent>0%</span>
            </div>

            <div class="rail-row">
              <span class="rail-row__label">Est. reading time</span>
              <span class="rail-row__value">
                {readingTimeMinutes} min ({wordCount.toLocaleString()} words)
              </span>
            </div>

            <div class="rail-row">
              <span class="rail-row__label">Reader size</span>
              <div class="reader-sizes" role="group" aria-label="Reader text size">
                <button type="button" data-reader-size="compact" aria-pressed="false">S</button>
                <button type="button" data-reader-size="standard" aria-pressed="true">M</button>
                <button type="button" data-reader-size="comfortable" aria-pressed="false">L</button>
              </div>
            </div>

            <div class="rail-actions">
              <button type="button" class="rail-action" data-copy-citation data-citation={citation}>
                <Icon name="copy" size={14} />
                <span data-copy-label>Copy citation</span>
              </button>
              <button type="button" class="rail-action" data-print aria-label="Print article">
                <Icon name="printer" size={14} />
                <span>Print</span>
              </button>
            </div>
          </div>

          {
            claims.length > 0 && (
              <div class="rail-card card">
                <EvidenceStrip counts={entryEvidence} label="Piece evidence profile" />
              </div>
            )
          }

          {
            railSections.length > 1 && (
              <nav class="rail-card card rail-toc" aria-label="Article sections">
                <p class="rail-card__label">On this page</p>
                <ol class="toc-list">
                  {railSections.map((section) => (
                    <li>
                      <a href={`#${section.id}`} data-toc-link>
                        {section.label}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  // ADR-0003's bounded interaction-event contract: article_view fires once
  // per load, engaged_read is wired by initEngagedRead, and artifact_open
  // fires only on a real artifact click. Data comes from the article
  // element's attributes because define:vars would force this into an
  // inline IIFE where the import cannot resolve.
  import { track, initEngagedRead } from '@/lib/analytics';

  const articleEl = document.querySelector('.article');
  const slug = articleEl?.getAttribute('data-slug');
  const topics = JSON.parse(articleEl?.getAttribute('data-topics') ?? '[]');

  if (slug) {
    track({ name: 'article_view', properties: { slug, topics } });
    initEngagedRead(slug);
  }

  for (const link of document.querySelectorAll('[data-artifact-id]')) {
    link.addEventListener('click', () => {
      const artifactId = link.getAttribute('data-artifact-id');
      if (artifactId) track({ name: 'artifact_open', properties: { artifactId } });
    });
  }
</script>

<script>
  // Progressive enhancement for the reading surface. All content and
  // navigation is present without JS; these controls only add progress,
  // persisted reader sizing, claims filtering, and citation/print actions.
  const body = document.querySelector<HTMLElement>('[data-article-body]');
  const article = document.querySelector<HTMLElement>('.article');
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const progressFill = document.querySelector<HTMLElement>('[data-reading-progress-fill]');
  const progressPercent = document.querySelector<HTMLElement>('[data-progress-percent]');
  const progressLabels = Array.from(
    document.querySelectorAll<HTMLElement>('[data-progress-label]'),
  );

  const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

  if (body && article) {
    let queued = false;
    let lastPercent = -1;

    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const tocTargets = tocLinks
      .map((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const target = document.getElementById(id);
        return target ? { id, target, links: tocLinks.filter((l) => l.hash === `#${id}`) } : null;
      })
      .filter(
        (entry): entry is { id: string; target: HTMLElement; links: HTMLAnchorElement[] } =>
          entry !== null,
      );

    const update = () => {
      queued = false;

      const rect = body.getBoundingClientRect();
      const bodyTop = rect.top + window.scrollY;
      const bodyHeight = body.offsetHeight;
      const start = bodyTop - window.innerHeight * 0.3;
      const end = bodyTop + bodyHeight - window.innerHeight * 0.7;
      const percent = Math.round(
        clamp(((window.scrollY - start) / Math.max(end - start, 1)) * 100, 0, 100),
      );

      if (percent !== lastPercent) {
        lastPercent = percent;
        if (progressFill) progressFill.style.transform = `scaleX(${percent / 100})`;
        progress?.setAttribute('aria-valuenow', String(percent));
        if (progressPercent) progressPercent.textContent = `${percent}%`;
        for (const label of progressLabels) label.textContent = `${percent}% read`;
      }

      if (tocTargets.length > 0) {
        let activeId = '';
        for (const entry of tocTargets) {
          if (entry.target.getBoundingClientRect().top <= 160) activeId = entry.id;
        }
        for (const entry of tocTargets) {
          const active = entry.id === activeId;
          for (const link of entry.links) {
            link.toggleAttribute('data-active', active);
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }
        }
      }
    };

    const requestUpdate = () => {
      if (queued) return;
      queued = true;
      window.requestAnimationFrame(update);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    update();
  }

  // Reader text size: compact / standard / comfortable, persisted.
  const READING_SIZES = ['compact', 'standard', 'comfortable'] as const;
  type ReadingSize = (typeof READING_SIZES)[number];
  const SIZE_LABELS: Record<ReadingSize, string> = {
    compact: 'Compact',
    standard: 'Standard',
    comfortable: 'Comfortable',
  };
  const sizeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-reader-size]'),
  );
  const cycleButton = document.querySelector<HTMLButtonElement>('[data-reading-cycle]');
  const cycleLabel = document.querySelector<HTMLElement>('[data-reading-mode-label]');

  const isReadingSize = (value: string | null | undefined): value is ReadingSize =>
    value !== null && value !== undefined && (READING_SIZES as readonly string[]).includes(value);

  let storedSize: string | null = null;
  try {
    storedSize = localStorage.getItem('rs-reading-mode');
  } catch {
    storedSize = null;
  }
  let readingSize: ReadingSize = isReadingSize(storedSize) ? storedSize : 'standard';

  const applyReadingSize = (size: ReadingSize, persist: boolean) => {
    readingSize = size;
    if (body) body.dataset.size = size;

    for (const button of sizeButtons) {
      const active = button.dataset.readerSize === size;
      button.toggleAttribute('data-active', active);
      button.setAttribute('aria-pressed', String(active));
    }

    if (cycleButton) {
      cycleButton.dataset.readingMode = size;
      cycleButton.setAttribute(
        'aria-label',
        `Reading mode: ${SIZE_LABELS[size]}. Activate to change text size.`,
      );
    }
    if (cycleLabel) cycleLabel.textContent = `Reading Mode: ${SIZE_LABELS[size]}`;

    if (persist) {
      try {
        localStorage.setItem('rs-reading-mode', size);
      } catch {
        // Persistence is optional; the session still changes size.
      }
    }
  };

  for (const button of sizeButtons) {
    button.addEventListener('click', () => {
      const size = button.dataset.readerSize;
      if (isReadingSize(size)) applyReadingSize(size, true);
    });
  }

  cycleButton?.addEventListener('click', () => {
    const nextIndex = (READING_SIZES.indexOf(readingSize) + 1) % READING_SIZES.length;
    applyReadingSize(READING_SIZES[nextIndex] ?? 'standard', true);
  });

  if (body) applyReadingSize(readingSize, false);

  // Claims ledger filtering.
  const claimFilterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-claim-filter]'),
  );
  const claimCards = Array.from(document.querySelectorAll<HTMLElement>('[data-claim]'));
  const claimCount = document.querySelector<HTMLElement>('[data-claim-count]');
  const claimEmpty = document.querySelector<HTMLElement>('[data-claim-empty]');

  const applyClaimFilter = (filter: string) => {
    let shown = 0;
    for (const card of claimCards) {
      const visible = filter === 'all' || card.dataset.evidence === filter;
      card.hidden = !visible;
      if (visible) shown++;
    }

    if (claimCount) {
      claimCount.textContent =
        filter === 'all'
          ? `Showing all ${claimCards.length}`
          : `Showing ${shown} of ${claimCards.length}`;
    }
    if (claimEmpty) claimEmpty.hidden = shown !== 0;

    for (const button of claimFilterButtons) {
      const active = button.dataset.claimFilter === filter;
      button.classList.toggle('claim-filter--active', active);
      button.setAttribute('aria-pressed', String(active));
    }
  };

  for (const button of claimFilterButtons) {
    button.addEventListener('click', () => applyClaimFilter(button.dataset.claimFilter ?? 'all'));
  }

  // Copy the canonical citation to the clipboard.
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-citation]');
  copyButton?.addEventListener('click', async () => {
    const text = copyButton.dataset.citation ?? '';
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }

    const label = copyButton.querySelector<HTMLElement>('[data-copy-label]');
    if (label) label.textContent = 'Copied citation';
    copyButton.setAttribute('data-copied', 'true');
    window.setTimeout(() => {
      if (label) label.textContent = 'Copy citation';
      copyButton.removeAttribute('data-copied');
    }, 2000);
  });

  document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => {
    window.print();
  });

  // A claim's source link points at the matching source card; briefly mark it
  // so the reader can see where the jump landed.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-source-link]')) {
    link.addEventListener('click', () => {
      const id = link.dataset.sourceLink;
      if (!id) return;
      for (const card of document.querySelectorAll<HTMLElement>('[data-source-id]')) {
        card.removeAttribute('data-highlighted');
      }
      document.getElementById(`source-${id}`)?.setAttribute('data-highlighted', '');
    });
  }
</script>

