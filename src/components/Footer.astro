---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { BUILD_TIME } from '@/lib/build-time';

const links = [
  { href: '/about', label: 'About' },
  { href: '/series', label: 'Series' },
  { href: '/artifacts', label: 'Artifacts Lab' },
  { href: '/editorial-policy', label: 'Editorial policy' },
  { href: '/corrections', label: 'Corrections' },
  { href: '/newsletter', label: 'Newsletter' },
  { href: '/search', label: 'Full search' },
];

const [articles, briefs, sources, artifacts] = await Promise.all([
  getCollection('articles'),
  getCollection('briefs'),
  getCollection('sources'),
  getCollection('artifacts'),
]);
const liveCount = getPublishedEntries([...articles, ...briefs], BUILD_TIME).length;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner shell">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="site-footer__name">Runtime Signals</p>
        <p class="site-footer__colophon">
          Failure mechanism, invariant, engineering practice. Every consequential claim is sourced
          or explicitly labeled as inference.
        </p>
        <p class="site-footer__stats">
          {liveCount} live publications · {sources.length} primary &amp; secondary sources · {
            artifacts.length
          } artifacts
        </p>
      </div>

      <div class="site-footer__aside">
        <nav aria-label="Footer">
          <ul class="site-footer__list">
            {
              links.map((link) => (
                <li>
                  <a href={link.href} class="unstyled-link">
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/rss.xml" class="unstyled-link">RSS</a></li>
            <li><a href="/atom.xml" class="unstyled-link">Atom</a></li>
          </ul>
        </nav>

        <button type="button" class="theme-toggle" data-theme-toggle>
          <span class="theme-toggle__icon theme-toggle__icon--moon"><Icon name="moon" /></span>
          <span class="theme-toggle__icon theme-toggle__icon--sun"><Icon name="sun" /></span>
          <span class="theme-toggle__label theme-toggle__label--dark">Dark instrument</span>
          <span class="theme-toggle__label theme-toggle__label--light">Mineral paper</span>
        </button>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {year} Runtime Signals. All substantive claims evidence-graded.</span>
      <a href="/authors/jordan-avery" class="site-footer__lead">Editorial lead: Jordan Avery</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    border-top: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--surface) 50%, var(--paper));
  }

  .site-footer__inner {
    padding-block: var(--space-7);
  }

  .site-footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .site-footer__name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
  }

  .site-footer__colophon {
    max-width: 34rem;
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .site-footer__stats {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .site-footer__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .site-footer__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .site-footer__list a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    color: var(--ink-muted);
    white-space: nowrap;
    touch-action: manipulation;
  }

  .site-footer__list a:hover,
  .site-footer__list a:focus-visible {
    color: var(--ink);
  }

  .site-footer__list li:nth-last-child(-n + 2) a {
    color: var(--signal);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    align-self: flex-start;
    min-block-size: 2.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
  }

  .theme-toggle:hover {
    border-color: var(--signal);
  }

  .theme-toggle__icon {
    color: var(--signal);
    flex-shrink: 0;
  }

  .theme-toggle__icon--sun,
  .theme-toggle__label--light {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle__icon--moon,
  :global([data-theme='dark']) .theme-toggle__label--dark {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle__icon--sun {
    display: block;
  }

  :global([data-theme='dark']) .theme-toggle__label--light {
    display: inline;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .site-footer__lead {
    color: var(--ink-muted);
  }

  .site-footer__lead:hover {
    color: var(--signal);
  }

  @media (min-width: 48rem) {
    .site-footer__top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .site-footer__aside {
      align-items: flex-end;
    }

    .theme-toggle {
      align-self: flex-end;
    }

    .site-footer__list {
      justify-content: flex-end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-footer__list a,
    .site-footer__lead,
    .theme-toggle {
      transition:
        color var(--motion-duration-fast) var(--motion-ease-out),
        border-color var(--motion-duration-fast) var(--motion-ease-out);
    }
  }
</style>
