{
  "name": "runtime-signals",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-approval-manifest.mjs && node scripts/check-mdx-imports.mjs",
    "build": "astro check && astro build",
    "postbuild": "pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/generate-approval-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test -c tests/a11y/playwright.config.ts",
    "verify:mdx": "node scripts/check-mdx-imports.mjs",
    "verify:docs": "markdownlint-cli2 && node scripts/check-docs-links.mjs",
    "verify:manifest": "node scripts/generate-approval-manifest.mjs",
    "verify:pagefind-size": "node scripts/measure-pagefind-index.mjs",
    "wrangler:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "astro": "7.2.9",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "3.7.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "markdownlint-cli2": "0.23.2",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
