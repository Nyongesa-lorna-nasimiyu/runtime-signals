---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EvidenceStrip from '@/components/EvidenceStrip.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { resolveTopicNames, weakestEvidence, evidenceCounts, articlePath } from '@/lib/resolve';
import { BUILD_TIME } from '@/lib/build-time';

const [articles, briefs] = await Promise.all([getCollection('articles'), getCollection('briefs')]);
const allLive = getPublishedEntries([...articles, ...briefs], BUILD_TIME);
const live = allLive.slice(0, 12);
const corpusEvidence = evidenceCounts(allLive);

const cards = await Promise.all(
  live.map(async (entry) => ({
    id: entry.id,
    path: articlePath(entry),
    title: entry.data.title,
    dek: entry.data.dek,
    publishedAt: entry.data.published_at,
    topics: await resolveTopicNames(entry),
    dominantEvidence: weakestEvidence(entry),
    evidence: evidenceCounts([entry]),
  })),
);
---

<BaseLayout
  title="Reliable AI-Agent Systems in Production"
  description="Systems analysis of evaluation, reliability, recovery, orchestration, state, memory, tool security, and observability for AI agents in production."
  canonicalPath="/"
>
  <section class="hero">
    <p class="eyebrow">
      A publication about running AI agents like they'll fail - because they will
    </p>
    <h1 class="hero__title">Runtime Signals</h1>
    <p class="hero__thesis">
      Every piece traces one chain: a real failure mechanism, the invariant it violates, and the
      engineering practice that holds under load. No unreviewed AI-generated articles. Every
      consequential claim is sourced or explicitly labeled as inference.
    </p>
    <div class="hero__evidence">
      <EvidenceStrip counts={corpusEvidence} label="Evidence across the corpus" />
    </div>
  </section>

  <section class="log">
    <div class="log__header">
      <h2 id="log-heading" class="eyebrow">Recent signals</h2>
      <span class="log__count">{cards.length} live</span>
    </div>
    {
      cards.length === 0 ? (
        <p class="log__empty">
          No approved, published pieces exist yet. This is expected at the Phase 2 checkpoint -
          content, review, and the CI approval manifest arrive together in Phase 4.
        </p>
      ) : (
        <div class="log__list">
          {cards.map((card) => (
            <ArticleCard {...card} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  /* Same --content-width as .log below, so the hero and "Recent signals"
     share one left edge. Centered blocks of different widths sit at
     different offsets: at 1280px the hero title started 238px to the LEFT
     of the list header, which reads as two columns that never aligned.
     Header/footer stay at --wide-width - chrome may be wider than the
     reading column, but adjacent content must not disagree with itself. */
  .hero {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-5) var(--space-6);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    margin: var(--space-3) 0 var(--space-5);
  }

  .hero__thesis {
    max-width: 62ch;
    font-size: var(--text-lg);
    color: var(--ink-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Wrapper element in the template owns this class. EvidenceStrip's root
     element belongs to EvidenceStrip.astro, so a class passed straight onto
     the component as a prop is never seen by this file's scoped <style> -
     both rules below silently never matched (the strip rendered at the full
     hero width instead of capping at 30rem, with no top margin). */
  .hero__evidence {
    margin-top: var(--space-7);
    max-width: 30rem;
  }

  .log {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--space-5) var(--space-9);
  }

  .log__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: var(--space-3);
  }

  .log__count {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--signal);
  }

  .log__empty {
    color: var(--ink-muted);
    padding: var(--space-6) 0;
  }
</style>
