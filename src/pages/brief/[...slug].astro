---
import { getCollection, getEntries, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getRoutableEntries, isArchived } from '@/lib/publication';
import { resolveAuthorNames, resolveTopicNames, resolveSeries } from '@/lib/resolve';
import { Callout, Figure } from '@/components/mdx';
import { BUILD_TIME } from '@/lib/build-time';
import { getRelatedContent } from '@/lib/related';

export async function getStaticPaths() {
  const briefs = await getCollection('briefs');
  const [allArticles, allSeries] = await Promise.all([
    getCollection('articles'),
    getCollection('series'),
  ]);
  const routable = getRoutableEntries(briefs, BUILD_TIME);
  return routable.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, relatedContent: getRelatedContent(entry, allArticles, allSeries) },
  }));
}

const { entry, relatedContent } = Astro.props;
const { Content, headings } = await render(entry);
const [authorNames, topicNames, series, sourceEntries, artifactEntries] = await Promise.all([
  resolveAuthorNames(entry),
  resolveTopicNames(entry),
  resolveSeries(entry),
  getEntries(entry.data.citations),
  getEntries(entry.data.artifacts),
]);
const sourceTitles = sourceEntries.map((s) => ({ id: s.id, title: s.data.title, url: s.data.url }));
const artifactTitles = artifactEntries.map((a) => ({
  id: a.id,
  title: a.data.title,
  url: a.data.url,
  kind: a.data.kind,
}));
---

<ArticleLayout
  entry={entry}
  authorNames={authorNames}
  topicNames={topicNames}
  series={series}
  sourceTitles={sourceTitles}
  artifactTitles={artifactTitles}
  archived={isArchived(entry)}
  relatedContent={relatedContent}
  bodyHeadings={headings}
>
  <Content components={{ Callout, Figure }} />
</ArticleLayout>
