---
import ProseLayout from '@/layouts/ProseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<ProseLayout
  eyebrow="Newsletter"
  title="Not live yet"
  description="Email distribution stays paused until DNS authentication and consent handling are verified."
  canonicalPath="/newsletter"
  noindex={true}
>
  <div class="newsletter-status" aria-label="Newsletter status">
    <p class="newsletter-status__label">Status</p>
    <p class="newsletter-status__copy">
      Provider verification is still in progress. No subscriber data is collected here.
    </p>
  </div>

  <p>
    There's no signup form on this page. The newsletter architecture is decided - a managed provider
    stays authoritative for subscriber state, this site never stores an email address, and no
    webhook endpoint exists until there's a durable store that actually needs one - but the provider
    itself hasn't been verified at the account level yet, and no production email will send until
    DNS authentication and consent handling are confirmed.
  </p>
  <p>
    Check back once that verification is complete. Until then, follow the publication with the feeds
    below.
  </p>

  <div class="newsletter-feeds">
    <a href="/rss.xml" class="btn">
      <span>RSS feed</span>
      <Icon name="arrow-up-right" size={14} />
    </a>
    <a href="/atom.xml" class="btn">
      <span>Atom feed</span>
      <Icon name="arrow-up-right" size={14} />
    </a>
  </div>
</ProseLayout>

<style>
  .newsletter-status {
    margin: 0 0 var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .newsletter-status__label {
    margin: 0;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .newsletter-status__copy {
    margin: var(--space-2) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .newsletter-feeds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
