---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="404"
  description="This signal was not found."
  canonicalPath="/404"
  noindex={true}
>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>No signal at this address</h1>
    <p>
      The page you're looking for was removed, moved, or linked from a stale address. Draft and
      unapproved content never gets a public URL.
    </p>
    <nav class="not-found__actions" aria-label="404 recovery">
      <a href="/" class="not-found__home">Back to Runtime Signals →</a>
      <a href="/articles">Browse articles</a>
      <a href="/search">Search the publication</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-5) var(--space-9);
    text-align: center;
  }
  .not-found h1 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-4);
  }
  .not-found p {
    color: var(--ink-muted);
    max-width: 50ch;
    margin: 0 auto;
  }
  .not-found__home {
    display: inline-flex;
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }
  .not-found__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
  }
  .not-found__actions a {
    display: inline-flex;
    min-block-size: var(--touch-target-min);
    align-items: center;
  }
</style>
