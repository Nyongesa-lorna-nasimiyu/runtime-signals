---
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { BUILD_TIME } from '@/lib/build-time';

const PAGE_SIZE = 10;
const briefs = await getCollection('briefs');
const live = getPublishedEntries(briefs, BUILD_TIME);
const totalPages = Math.ceil(live.length / PAGE_SIZE);
---

<ArchiveLayout
  entries={live.slice(0, PAGE_SIZE)}
  allEntries={live}
  title="Agent Engineering Brief"
  eyebrow="Weekly Engineering Briefs"
  description="Concise weekly signals covering emerging papers, benchmark telemetry anomalies, and runtime safety findings."
  canonicalPath="/brief"
  basePath="/brief"
  currentPage={1}
  totalPages={totalPages}
  emptyMessage="No published briefs yet."
/>
