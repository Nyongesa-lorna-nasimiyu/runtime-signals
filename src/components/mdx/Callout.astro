---
// Allow-listed MDX component (docs/security/threat-model.md). `kind` maps to the
// same evidence-strength vocabulary used elsewhere so a callout's color always means
// the same thing across the site.
interface Props {
  kind?: 'note' | 'warning' | 'evidence-gap';
}
const { kind = 'note' } = Astro.props;
---

<aside class="callout" data-kind={kind} role="note">
  <p class="callout__label eyebrow">
    {kind === 'warning' ? 'Caution' : kind === 'evidence-gap' ? 'Evidence gap' : 'Note'}
  </p>
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    border-left: 3px solid var(--signal);
    background: var(--signal-dim);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-6) 0;
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .callout[data-kind='warning'] {
    border-left-color: var(--evidence-mixed);
    background: color-mix(in srgb, var(--evidence-mixed) 12%, var(--paper-raised));
  }
  .callout[data-kind='evidence-gap'] {
    border-left-color: var(--evidence-inference);
    background: color-mix(in srgb, var(--evidence-inference) 12%, var(--paper-raised));
  }
  .callout__label {
    margin: 0 0 var(--space-2);
  }
  .callout__body {
    font-size: var(--text-base);
  }
  .callout__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
