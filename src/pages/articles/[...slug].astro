---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getRoutableEntries, isArchived } from '@/lib/publication';
import {
  resolveAuthorNames,
  resolveTopicItems,
  resolveSeries,
  resolveSourceSummaries,
  resolveArtifactSummaries,
} from '@/lib/resolve';
import { Callout, Figure } from '@/components/mdx';
import { BUILD_TIME } from '@/lib/build-time';
import { getRelatedContent } from '@/lib/related';

// This is the actual draft/future/unapproved exclusion boundary: getStaticPaths only
// ever iterates getRoutableEntries(), so a draft, a not-yet-due scheduled piece, or
// an unapproved commit is never given a route at all - not filtered from a listing,
// genuinely absent as a URL. Proven against the real dist/ output by
// scripts/verify-draft-exclusion.mjs (a black-box check, not a mock - see
// tests/integration/README.md for why this isn't a vitest integration test).
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const allSeries = await getCollection('series');
  const routable = getRoutableEntries(articles, BUILD_TIME);
  return routable.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, relatedContent: getRelatedContent(entry, articles, allSeries) },
  }));
}

const { entry, relatedContent } = Astro.props;
const { Content, headings } = await render(entry);
const [authorNames, topicItems, series, sources, artifacts] = await Promise.all([
  resolveAuthorNames(entry),
  resolveTopicItems(entry),
  resolveSeries(entry),
  resolveSourceSummaries(entry),
  resolveArtifactSummaries(entry),
]);
---

<ArticleLayout
  entry={entry}
  authorNames={authorNames}
  topicItems={topicItems}
  series={series}
  sources={sources}
  artifacts={artifacts}
  archived={isArchived(entry)}
  relatedContent={relatedContent}
  bodyHeadings={headings}
>
  <Content components={{ Callout, Figure }} />
</ArticleLayout>
