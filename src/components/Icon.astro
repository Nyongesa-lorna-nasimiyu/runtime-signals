---
// Small, dependency-free icon set for the static Astro shell. The React
// islands keep their own inline icons, so the site does not need an icon
// package just to render a search magnifier or a chevron.
interface Props {
  name:
    | 'search'
    | 'menu'
    | 'close'
    | 'moon'
    | 'sun'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'arrow-left'
    | 'chevron-down'
    | 'external-link'
    | 'copy'
    | 'check'
    | 'printer'
    | 'book-open'
    | 'archive'
    | 'alert-triangle'
    | 'sliders'
    | 'circle'
    | 'check-circle';
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 16 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'search' && (
      <>
        <>
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </>
      </>
    )
  }
  {
    name === 'menu' && (
      <>
        <>
          <path d="M4 6h16" />
          <path d="M4 12h16" />
          <path d="M4 18h16" />
        </>
      </>
    )
  }
  {
    name === 'close' && (
      <>
        <>
          <path d="m6 6 12 12" />
          <path d="M18 6 6 18" />
        </>
      </>
    )
  }
  {name === 'moon' && <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 7 7 0 1 0 20 14.5Z" />}
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2" />
        <path d="M12 20v2" />
        <path d="m4.9 4.9 1.4 1.4" />
        <path d="m17.7 17.7 1.4 1.4" />
        <path d="M2 12h2" />
        <path d="M20 12h2" />
        <path d="m4.9 19.1 1.4-1.4" />
        <path d="m17.7 6.3 1.4-1.4" />
      </>
    )
  }
  {
    name === 'arrow-right' && (
      <>
        <>
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </>
      </>
    )
  }
  {
    name === 'arrow-up-right' && (
      <>
        <>
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </>
      </>
    )
  }
  {
    name === 'arrow-left' && (
      <>
        <>
          <path d="M19 12H5" />
          <path d="m11 6-6 6 6 6" />
        </>
      </>
    )
  }
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {
    name === 'external-link' && (
      <>
        <path d="M14 4h6v6" />
        <path d="M20 4 10 14" />
        <path d="M20 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5" />
      </>
    )
  }
  {
    name === 'copy' && (
      <>
        <rect x="9" y="9" width="11" height="11" rx="1.5" />
        <path d="M5 15V5a1 1 0 0 1 1-1h9" />
      </>
    )
  }
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {
    name === 'printer' && (
      <>
        <path d="M7 8V3h10v5" />
        <rect x="4" y="8" width="16" height="9" rx="1.5" />
        <path d="M7 14h10v7H7z" />
      </>
    )
  }
  {
    name === 'book-open' && (
      <>
        <path d="M12 6c-2-1.5-4.5-2-8-2v14c3.5 0 6 .5 8 2 2-1.5 4.5-2 8-2V4c-3.5 0-6 .5-8 2Z" />
        <path d="M12 6v14" />
      </>
    )
  }
  {
    name === 'archive' && (
      <>
        <rect x="3" y="4" width="18" height="4" rx="1" />
        <path d="M5 8v11h14V8" />
        <path d="M10 12h4" />
      </>
    )
  }
  {
    name === 'alert-triangle' && (
      <>
        <path d="m12 3 9 16H3L12 3Z" />
        <path d="M12 9v4" />
        <path d="M12 16h.01" />
      </>
    )
  }
  {
    name === 'sliders' && (
      <>
        <path d="M4 6h10" />
        <path d="M18 6h2" />
        <path d="M4 12h2" />
        <path d="M10 12h10" />
        <path d="M4 18h10" />
        <path d="M18 18h2" />
        <circle cx="16" cy="6" r="2" />
        <circle cx="8" cy="12" r="2" />
        <circle cx="16" cy="18" r="2" />
      </>
    )
  }
  {name === 'circle' && <circle cx="12" cy="12" r="8" />}
  {
    name === 'check-circle' && (
      <>
        <>
          <circle cx="12" cy="12" r="9" />
          <path d="m8 12 3 3 5-6" />
        </>
      </>
    )
  }
</svg>
