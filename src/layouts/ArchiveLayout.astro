---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EvidenceStrip from '@/components/EvidenceStrip.astro';
import Pagination from '@/components/Pagination.astro';
import { articlePath, evidenceCounts, resolveTopicNames, weakestEvidence } from '@/lib/resolve';

type Editorial = CollectionEntry<'articles'> | CollectionEntry<'briefs'>;

interface Props {
  entries: Editorial[];
  allEntries: Editorial[];
  title: string;
  eyebrow: string;
  description: string;
  canonicalPath: string;
  basePath: '/articles' | '/brief';
  currentPage: number;
  totalPages: number;
  showKindFilter?: boolean;
  emptyMessage: string;
}

const {
  entries,
  allEntries,
  title,
  eyebrow,
  description,
  canonicalPath,
  basePath,
  currentPage,
  totalPages,
  showKindFilter = false,
  emptyMessage,
} = Astro.props;

const [topics, sources] = await Promise.all([getCollection('topics'), getCollection('sources')]);
const topicsList = topics.slice().sort((a, b) => a.data.name.localeCompare(b.data.name));

const cards = await Promise.all(
  entries.map(async (entry) => {
    const topicIds = entry.data.topics.map((topic) => topic.id);
    return {
      id: entry.id,
      path: articlePath(entry),
      title: entry.data.title,
      dek: entry.data.dek,
      publishedAt: entry.data.published_at,
      topics: await resolveTopicNames(entry),
      topicIds,
      kind: entry.collection === 'briefs' ? 'brief' : entry.data.kind,
      readingTimeMinutes: entry.data.reading_time_minutes,
      dominantEvidence: weakestEvidence(entry),
      evidence: evidenceCounts([entry]),
      claimCount: entry.data.claims.length,
    };
  }),
);

const kindTabs = [
  { id: 'all', label: 'All formats' },
  { id: 'deep-dive', label: 'Deep-dives' },
  { id: 'tutorial', label: 'Tutorials' },
  { id: 'article', label: 'Articles' },
  { id: 'case-study', label: 'Case studies' },
].filter(
  (tab) =>
    tab.id === 'all' ||
    allEntries.some((entry) =>
      entry.collection === 'briefs' ? tab.id === 'brief' : entry.data.kind === tab.id,
    ),
);

const totalClaims = allEntries.reduce((sum, entry) => sum + entry.data.claims.length, 0);
const corpusEvidence = evidenceCounts(allEntries);
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <div class="archive shell">
    <header class="archive-hero">
      <div class="archive-hero__copy">
        <p class="eyebrow eyebrow--signal">{eyebrow}</p>
        <h1 class="archive-hero__title">{title}</h1>
        <p class="archive-hero__description">{description}</p>
      </div>

      <div class="archive-hero__panel card">
        <div class="archive-stats">
          <div class="archive-stat">
            <span class="archive-stat__value">{allEntries.length}</span>
            <span class="archive-stat__label">Live pieces</span>
          </div>
          <div class="archive-stat">
            <span class="archive-stat__value">{totalClaims}</span>
            <span class="archive-stat__label">Graded claims</span>
          </div>
          <div class="archive-stat">
            <span class="archive-stat__value">{sources.length}</span>
            <span class="archive-stat__label">Sources</span>
          </div>
        </div>
        <EvidenceStrip counts={corpusEvidence} label="Evidence across the collection" />
      </div>
    </header>

    <section class="archive-body" aria-labelledby="archive-list-title">
      <h2 id="archive-list-title" class="visually-hidden">Archive entries</h2>

      <div class="archive-controls">
        <div class="archive-filters">
          {
            showKindFilter && (
              <div class="archive-tabs" role="group" aria-label="Filter by format">
                {kindTabs.map((tab) => (
                  <button
                    type="button"
                    class:list={['archive-tab', { 'archive-tab--active': tab.id === 'all' }]}
                    data-archive-kind={tab.id}
                    aria-pressed={tab.id === 'all' ? 'true' : 'false'}
                  >
                    {tab.label}
                  </button>
                ))}
              </div>
            )
          }

          <label class="visually-hidden" for="archive-topic">Filter by topic</label>
          <select id="archive-topic" class="select archive-select" data-archive-topic>
            <option value="all">All topics</option>
            {topicsList.map((topic) => <option value={topic.id}>{topic.data.name}</option>)}
          </select>
        </div>

        <div class="archive-sort">
          <label class="visually-hidden" for="archive-sort">Sort entries</label>
          <select id="archive-sort" class="select archive-select" data-archive-sort>
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="claims">Most graded claims</option>
          </select>
          <span class="archive-count" data-archive-count>
            {entries.length} of {allEntries.length} live
          </span>
        </div>
      </div>

      {
        cards.length === 0 ? (
          <p class="archive-empty">{emptyMessage}</p>
        ) : (
          <div class="archive-list" data-archive-list>
            {cards.map((card) => (
              <div
                data-archive-entry
                data-kind={card.kind}
                data-topics={card.topicIds.join(' ')}
                data-published={card.publishedAt.toISOString()}
                data-claims={card.claimCount}
              >
                <ArticleCard
                  id={card.id}
                  path={card.path}
                  title={card.title}
                  dek={card.dek}
                  publishedAt={card.publishedAt}
                  topics={card.topics}
                  topicIds={card.topicIds}
                  kind={card.kind}
                  readingTimeMinutes={card.readingTimeMinutes}
                  dominantEvidence={card.dominantEvidence}
                  evidence={card.evidence}
                  headingLevel={2}
                />
              </div>
            ))}
          </div>
        )
      }

      <div class="archive-empty" data-archive-empty hidden>
        <p>No entries on this page match the active filters.</p>
        <button type="button" class="archive-reset" data-archive-reset>Reset filters</button>
      </div>

      {
        totalPages > 1 && (
          <p class="archive-note">
            Filters apply to this page. Use pagination to browse the full archive.
          </p>
        )
      }

      <Pagination basePath={basePath} currentPage={currentPage} totalPages={totalPages} />
    </section>
  </div>
</BaseLayout>

<script>
  const list = document.querySelector<HTMLElement>('[data-archive-list]');
  const count = document.querySelector<HTMLElement>('[data-archive-count]');
  const empty = document.querySelector<HTMLElement>('[data-archive-empty]');
  const topicSelect = document.querySelector<HTMLSelectElement>('[data-archive-topic]');
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-archive-sort]');
  const kindButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-archive-kind]'),
  );
  const reset = document.querySelector<HTMLButtonElement>('[data-archive-reset]');

  if (list && count && empty) {
    const entries = Array.from(list.querySelectorAll<HTMLElement>('[data-archive-entry]'));
    const totalLive = count.textContent?.match(/of\s+(\d+)/)?.[1] ?? String(entries.length);

    let activeKind = 'all';
    let activeTopic = 'all';
    let activeSort = 'newest';

    const apply = () => {
      const matching = entries.filter((entry) => {
        const kinds = (entry.dataset.kind ?? '').split(' ');
        const topics = new Set((entry.dataset.topics ?? '').split(' ').filter(Boolean));
        return (
          (activeKind === 'all' || kinds.includes(activeKind)) &&
          (activeTopic === 'all' || topics.has(activeTopic))
        );
      });

      const sorted = matching.slice().sort((a, b) => {
        if (activeSort === 'oldest') {
          return (a.dataset.published ?? '').localeCompare(b.dataset.published ?? '');
        }
        if (activeSort === 'claims') {
          return Number(b.dataset.claims ?? 0) - Number(a.dataset.claims ?? 0);
        }
        return (b.dataset.published ?? '').localeCompare(a.dataset.published ?? '');
      });

      for (const entry of entries) entry.hidden = true;
      for (const entry of sorted) {
        entry.hidden = false;
        list.append(entry);
      }

      const filtered = activeKind !== 'all' || activeTopic !== 'all';
      count.textContent = filtered
        ? `${sorted.length} matching on this page`
        : `${entries.length} of ${totalLive} live`;
      empty.hidden = sorted.length !== 0;

      for (const button of kindButtons) {
        const active = button.dataset.archiveKind === activeKind;
        button.classList.toggle('archive-tab--active', active);
        button.setAttribute('aria-pressed', String(active));
      }
    };

    for (const button of kindButtons) {
      button.addEventListener('click', () => {
        activeKind = button.dataset.archiveKind ?? 'all';
        apply();
      });
    }

    topicSelect?.addEventListener('change', () => {
      activeTopic = topicSelect.value;
      apply();
    });

    sortSelect?.addEventListener('change', () => {
      activeSort = sortSelect.value;
      apply();
    });

    reset?.addEventListener('click', () => {
      activeKind = 'all';
      activeTopic = 'all';
      activeSort = 'newest';
      if (topicSelect) topicSelect.value = 'all';
      if (sortSelect) sortSelect.value = 'newest';
      apply();
    });

    apply();
  }
</script>

<style>
  .archive {
    padding-block: var(--space-7) var(--space-9);
  }

  .archive-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--hairline);
  }

  .archive-hero__title {
    margin: var(--space-2) 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .archive-hero__description {
    max-width: 60ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .archive-hero__panel {
    padding: var(--space-4);
  }

  .archive-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }

  .archive-stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .archive-stat__value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .archive-stat__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);
  }

  .archive-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--hairline);
  }

  .archive-filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .archive-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface-subtle);
    align-self: flex-start;
  }

  .archive-tab {
    min-block-size: 2.125rem;
    padding: 0.3rem 0.6rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    touch-action: manipulation;
  }

  .archive-tab:hover {
    color: var(--ink);
  }

  .archive-tab--active {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .archive-select {
    inline-size: 100%;
    min-block-size: 2.5rem;
  }

  .archive-sort {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .archive-sort .archive-select {
    flex: 1;
    min-inline-size: 0;
  }

  .archive-count {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--signal);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .archive-list {
    max-width: 56rem;
  }

  .archive-empty {
    padding-block: var(--space-7);
  }

  .archive-empty p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .archive-reset {
    margin-top: var(--space-2);
    padding: 0;
    border: 0;
    background: none;
    color: var(--signal);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  .archive-note {
    margin: var(--space-5) 0 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  @media (min-width: 40rem) {
    .archive-filters {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }

    .archive-select {
      inline-size: auto;
      min-inline-size: 12rem;
    }

    .archive-sort {
      justify-content: flex-end;
    }

    .archive-sort .archive-select {
      flex: 0 0 auto;
      min-inline-size: 12rem;
    }
  }

  @media (min-width: 64rem) {
    .archive-hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
      gap: var(--space-7);
    }

    .archive-hero__copy {
      grid-column: span 7;
    }

    .archive-hero__panel {
      grid-column: span 5;
    }

    .archive-controls {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .archive-sort {
      justify-content: flex-start;
    }
  }
</style>
