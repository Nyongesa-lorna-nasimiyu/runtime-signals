---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { BUILD_TIME } from '@/lib/build-time';

const [sources, articles, briefs] = await Promise.all([
  getCollection('sources'),
  getCollection('articles'),
  getCollection('briefs'),
]);
const live = getPublishedEntries([...articles, ...briefs], BUILD_TIME);

const sortedSources = sources.slice().sort((a, b) => a.data.title.localeCompare(b.data.title));
const sourceTypes = [...new Set(sortedSources.map((source) => source.data.source_type))].sort();
const primaryCount = sortedSources.filter((source) => source.data.primary).length;

const citationsBySource = new Map<string, number>();
for (const entry of live) {
  const ids = new Set([
    ...entry.data.citations.map((source) => source.id),
    ...entry.data.claims.flatMap((claim) => claim.sources.map((source) => source.id)),
  ]);
  for (const id of ids) citationsBySource.set(id, (citationsBySource.get(id) ?? 0) + 1);
}
---

<BaseLayout
  title="Sources"
  description="Papers, reports, repositories, benchmarks, datasets, tools, and case studies Runtime Signals cites."
  canonicalPath="/sources"
>
  <div class="sources-page shell">
    <PageHero
      eyebrow="Evidence & Provenance Registry"
      title="Sources"
      description="Every primary specification, peer-reviewed paper, benchmark, repository, and engineering report cited by Runtime Signals - preserved with publisher and access dates."
    >
      <div slot="panel" class="source-stats">
        <div>
          <span class="source-stats__value">{sortedSources.length}</span>
          <span class="source-stats__label">Total sources</span>
        </div>
        <div>
          <span class="source-stats__value">{primaryCount}</span>
          <span class="source-stats__label">Primary</span>
        </div>
        <div>
          <span class="source-stats__value">{sourceTypes.length}</span>
          <span class="source-stats__label">Source types</span>
        </div>
      </div>
    </PageHero>

    <section class="source-registry" aria-labelledby="source-registry-title">
      <h2 id="source-registry-title" class="visually-hidden">Source registry</h2>

      <div class="source-controls">
        <div class="source-controls__filters">
          <div class="source-search">
            <span class="source-search__icon" aria-hidden="true"
              ><Icon name="search" size={14} /></span
            >
            <label class="visually-hidden" for="source-search">Filter sources</label>
            <input
              id="source-search"
              type="search"
              class="input source-search__input"
              placeholder="Filter sources or publishers..."
              data-source-search
            />
          </div>

          <label class="visually-hidden" for="source-type">Filter by source type</label>
          <select id="source-type" class="select source-select" data-source-type>
            <option value="all">All source types</option>
            {sourceTypes.map((type) => <option value={type}>{type}</option>)}
          </select>

          <label class="source-primary">
            <input type="checkbox" data-source-primary />
            <span>Primary sources only</span>
          </label>
        </div>

        <span class="source-count" data-source-count>
          {sortedSources.length} of {sortedSources.length} sources
        </span>
      </div>

      <ul class="source-registry__list" data-source-list>
        {
          sortedSources.map((source) => {
            const citations = citationsBySource.get(source.id) ?? 0;
            return (
              <li
                class="source-row"
                data-source-row
                data-type={source.data.source_type}
                data-primary={source.data.primary ? 'true' : 'false'}
                data-search={`${source.data.title} ${source.data.publisher} ${source.data.notes ?? ''}`.toLowerCase()}
              >
                <div class="source-row__main">
                  <div class="source-row__meta">
                    <span class="source-row__type">{source.data.source_type}</span>
                    <span aria-hidden="true">·</span>
                    <span>{source.data.primary ? 'Primary' : 'Secondary'}</span>
                    <span aria-hidden="true">·</span>
                    <span>{source.data.publisher}</span>
                    <span aria-hidden="true">·</span>
                    <span>Accessed {source.data.accessed_at.toISOString().slice(0, 10)}</span>
                  </div>

                  <h3 class="source-row__title">
                    <a href={`/sources/${source.id}`}>{source.data.title}</a>
                  </h3>

                  {source.data.notes && <p class="source-row__notes">{source.data.notes}</p>}
                </div>

                <div class="source-row__aside">
                  <span class="source-row__citations">
                    Cited in {citations} {citations === 1 ? 'piece' : 'pieces'}
                  </span>
                  <a
                    href={source.data.url}
                    class="source-row__open"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>Open</span>
                    <Icon name="external-link" size={12} />
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>

      <div class="source-empty" data-source-empty hidden>
        <p>No sources match the active filters.</p>
        <button type="button" data-source-reset>Reset filters</button>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-source-search]');
  const type = document.querySelector<HTMLSelectElement>('[data-source-type]');
  const primary = document.querySelector<HTMLInputElement>('[data-source-primary]');
  const count = document.querySelector<HTMLElement>('[data-source-count]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-source-row]'));
  const empty = document.querySelector<HTMLElement>('[data-source-empty]');
  const reset = document.querySelector<HTMLButtonElement>('[data-source-reset]');

  if (search && type && primary && count && empty) {
    const apply = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;

      for (const row of rows) {
        const matchesQuery = !query || (row.dataset.search ?? '').includes(query);
        const matchesType = type.value === 'all' || row.dataset.type === type.value;
        const matchesPrimary = !primary.checked || row.dataset.primary === 'true';
        const show = matchesQuery && matchesType && matchesPrimary;
        row.hidden = !show;
        if (show) visible++;
      }

      count.textContent = `${visible} of ${rows.length} sources`;
      empty.hidden = visible !== 0;
    };

    search.addEventListener('input', apply);
    type.addEventListener('change', apply);
    primary.addEventListener('change', apply);

    reset?.addEventListener('click', () => {
      search.value = '';
      type.value = 'all';
      primary.checked = false;
      apply();
      search.focus();
    });
  }
</script>

<style>
  .sources-page {
    padding-block: var(--space-7) var(--space-9);
  }

  .source-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .source-stats > div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .source-stats__value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .source-stats__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);
  }

  .source-registry {
    margin-top: var(--space-6);
  }

  .source-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--hairline);
  }

  .source-controls__filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .source-search {
    position: relative;
    width: 100%;
  }

  .source-search__icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.75rem;
    display: inline-flex;
    transform: translateY(-50%);
    color: var(--ink-muted);
    pointer-events: none;
  }

  .source-search__input {
    width: 100%;
    padding-inline-start: 2rem;
  }

  .source-select {
    width: 100%;
  }

  .source-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 2.5rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .source-primary input {
    accent-color: var(--signal);
    width: 1rem;
    height: 1rem;
  }

  .source-count {
    flex-shrink: 0;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .source-registry__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .source-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--hairline);
  }

  .source-row__main {
    min-width: 0;
  }

  .source-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.55rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .source-row__type {
    color: var(--signal);
    text-transform: uppercase;
  }

  .source-row__title {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  .source-row__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .source-row__title a:hover {
    color: var(--signal);
  }

  .source-row__notes {
    max-width: 48rem;
    margin: var(--space-1) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .source-row__aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .source-row__citations {
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .source-row__open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--signal);
    text-decoration: none;
  }

  .source-row__open:hover {
    text-decoration: underline;
  }

  .source-empty {
    padding-block: var(--space-6);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .source-empty p {
    margin: 0;
  }

  .source-empty button {
    margin-top: var(--space-2);
    padding: 0;
    border: 0;
    background: none;
    color: var(--signal);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  @media (min-width: 40rem) {
    .source-controls {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .source-controls__filters {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }

    .source-search {
      width: 16rem;
    }

    .source-select {
      width: auto;
    }

    .source-row {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-5);
    }
  }
</style>
