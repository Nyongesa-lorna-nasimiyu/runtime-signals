---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchIsland from '@/components/SearchIsland';
---

<BaseLayout
  title="Search"
  description="Search Runtime Signals articles, briefs, and sources."
  canonicalPath="/search"
>
  <section class="search-page">
    <p class="eyebrow">Search</p>
    <h1>Search Runtime Signals</h1>
    <SearchIsland client:idle />
    <noscript>
      <p>
        Search requires JavaScript. Browse <a href="/articles">all articles</a> or <a href="/topics"
          >topics</a
        > instead.
      </p>
    </noscript>
  </section>
</BaseLayout>

<style>
  .search-page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }
  .search-page h1 {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-5);
  }
</style>

<style is:global>
  .search-island__input {
    width: 100%;
    min-block-size: var(--touch-target-comfortable);
    font-family: var(--font-display);
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: var(--ink);
    touch-action: manipulation;
  }

  @media (prefers-reduced-motion: no-preference) {
    .search-island__input {
      transition: border-color var(--motion-duration-fast) var(--motion-ease-out);
    }
  }
  .search-island__status {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-top: var(--space-2);
  }
  .search-island__filters {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }
  .search-island__filters summary {
    cursor: pointer;
    color: var(--ink-muted);
    min-block-size: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
  }
  .search-island__filters summary:hover,
  .search-island__filters summary:focus-visible {
    color: var(--ink);
  }
  .search-island__facet {
    border: none;
    border-top: 1px solid var(--hairline);
    padding: var(--space-3) 0 0;
    margin: var(--space-3) 0 0;
  }
  .search-island__facet legend {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    padding: 0;
    margin-bottom: var(--space-2);
  }
  .search-island__facet-option {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--touch-target-comfortable);
    color: var(--ink);
  }
  .search-island__facet-count {
    color: var(--ink-muted);
  }
  .search-island__clear-filters {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    background: none;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    min-block-size: var(--touch-target-min);
  }
  .search-island__clear-filters:hover,
  .search-island__clear-filters:focus-visible {
    color: var(--ink);
    border-color: var(--ink-muted);
  }
  .search-island__results {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .search-island__results li {
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-3);
  }
  .search-island__span-id {
    margin-right: var(--space-2);
  }
  .search-island__results p {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
