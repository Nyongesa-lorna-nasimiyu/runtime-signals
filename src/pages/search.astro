---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchIsland from '@/components/SearchIsland';
---

<BaseLayout
  title="Search"
  description="Search Runtime Signals articles, briefs, and sources."
  canonicalPath="/search"
>
  <section class="search-page">
    <p class="eyebrow">Search</p>
    <h1>Search Runtime Signals</h1>
    <SearchIsland client:idle />
    <noscript>
      <p>
        Search requires JavaScript. Browse <a href="/articles">all articles</a> or <a href="/topics"
          >topics</a
        > instead.
      </p>
    </noscript>
  </section>
</BaseLayout>

<style>
  .search-page {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }
  .search-page h1 {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-5);
  }
</style>

<style is:global>
  .search-island__input {
    width: 100%;
    font-family: var(--font-display);
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: var(--ink);
  }
  .search-island__status {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-top: var(--space-2);
  }
  .search-island__results {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .search-island__results li {
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-3);
  }
  .search-island__results p {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
