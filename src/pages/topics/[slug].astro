---
import { getCollection, getEntries } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import EvidenceStrip from '@/components/EvidenceStrip.astro';
import PageHero from '@/components/PageHero.astro';
import { getPublishedEntries } from '@/lib/publication';
import { evidenceCounts } from '@/lib/resolve';
import { buildEntryCards } from '@/lib/cards';
import { BUILD_TIME } from '@/lib/build-time';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({ params: { slug: topic.id }, props: { topic } }));
}

const { topic } = Astro.props;
const [articles, briefs, relatedTopics] = await Promise.all([
  getCollection('articles'),
  getCollection('briefs'),
  getEntries(topic.data.related),
]);
const live = getPublishedEntries([...articles, ...briefs], BUILD_TIME).filter((entry) =>
  entry.data.topics.some((reference) => reference.id === topic.id),
);
const cards = await buildEntryCards(live);
const topicEvidence = evidenceCounts(live);
---

<BaseLayout
  title={topic.data.name}
  description={topic.data.description}
  canonicalPath={`/topics/${topic.id}`}
>
  <div class="topic-page shell">
    <PageHero
      eyebrow={topic.data.pillar ? 'Pillar Topic Hub' : 'Cross-Cutting Topic'}
      title={topic.data.name}
      description={topic.data.description}
      backHref="/topics"
      backLabel="All topics"
    >
      {
        relatedTopics.length > 0 && (
          <p class="related-topics">
            <span>Related topics:</span>{' '}
            {relatedTopics.map((related, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={`/topics/${related.id}`}>{related.data.name}</a>
              </>
            ))}
          </p>
        )
      }

      <div slot="panel">
        <EvidenceStrip counts={topicEvidence} label={`${topic.data.name} evidence breakdown`} />
      </div>
    </PageHero>

    <section class="topic-entries" aria-labelledby="topic-entries-title">
      <div class="topic-entries__head">
        <h2 id="topic-entries-title">Live entries in {topic.data.name}</h2>
        <span>{live.length} live</span>
      </div>

      {
        cards.length === 0 ? (
          <p class="topic-entries__empty">No live entries published under this topic yet.</p>
        ) : (
          <div class="topic-entries__list">
            {cards.map((card) => (
              <ArticleCard {...card} headingLevel={2} />
            ))}
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .topic-page {
    padding-block: var(--space-7) var(--space-9);
  }

  .related-topics {
    margin: var(--space-4) 0 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .related-topics a {
    color: var(--signal);
    text-decoration: none;
  }

  .related-topics a:hover {
    text-decoration: underline;
  }

  .topic-entries {
    max-width: 56rem;
    margin-top: var(--space-6);
  }

  .topic-entries__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--hairline);
  }

  .topic-entries__head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .topic-entries__head span {
    flex-shrink: 0;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .topic-entries__empty {
    padding-block: var(--space-6);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
