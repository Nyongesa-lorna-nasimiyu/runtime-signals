---
import ProseLayout from '@/layouts/ProseLayout.astro';
import EvidenceTag from '@/components/EvidenceTag.astro';

const grades = [
  {
    grade: 'supported',
    description:
      'Backed directly by a primary source - standards, papers, official docs, or source repositories.',
  },
  {
    grade: 'mixed',
    description:
      'Partially supported by available telemetry or studies; the boundary gap is stated explicitly.',
  },
  {
    grade: 'inference',
    description:
      'Engineering reasoning derived from cited runtime behavior, not a direct source quotation.',
  },
  {
    grade: 'opinion',
    description: 'Editorial judgment on architectural trade-offs, labeled explicitly as judgment.',
  },
] as const;
---

<ProseLayout
  eyebrow="Methodology"
  title="How claims are sourced and labeled"
  description="How Runtime Signals sources, grades, and reviews assertions before publication."
  canonicalPath="/methodology"
>
  <p>
    Every article names a real system problem, states the invariant it violates, explains the
    failure mechanism, and gives an implementable practice - with limitations stated, not implied.
    Every consequential claim carries one of four labels, shown on the article itself:
  </p>

  <ul class="evidence-key">
    {
      grades.map((item) => (
        <li>
          <span class="evidence-key__tag">
            <EvidenceTag evidence={item.grade} />
          </span>
          <span class="evidence-key__description">{item.description}</span>
        </li>
      ))
    }
  </ul>

  <p>
    A claim labeled <EvidenceTag evidence="supported" /> or <EvidenceTag evidence="mixed" /> is rejected
    at the publication gate if it cites no source - this is enforced in the content schema, not just editorial
    review.
  </p>

  <h2>Source priority</h2>
  <p>Ranked, not arbitrary - each tier below only backs a claim when nothing higher applies.</p>
  <ol class="priority-list">
    <li>
      Standards, specifications, official documentation, source repositories, and original papers.
    </li>
    <li>Maintainer-authored engineering reports and reproducible production write-ups.</li>
    <li>Benchmark and dataset documentation and code.</li>
    <li>
      Credible secondary analysis, for discovery or context - never as sole proof for a
      consequential claim.
    </li>
  </ol>
  <p>
    Every source record keeps its access date, since pricing, limits, APIs, and policies change. We
    recheck time-sensitive claims before publishing and before any claim likely to have moved.
  </p>
</ProseLayout>

<style>
  .evidence-key {
    list-style: none;
    margin: var(--space-5) 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .evidence-key li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border-top: 1px solid var(--hairline);
  }

  .evidence-key li:first-child {
    border-top: 0;
  }

  .evidence-key__tag {
    flex-shrink: 0;
  }

  .evidence-key__description {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  @media (min-width: 40rem) {
    .evidence-key li {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-4);
    }

    .evidence-key__tag {
      inline-size: 7rem;
    }
  }

  .priority-list {
    padding-left: 0;
    margin: var(--space-5) 0;
    list-style: none;
    counter-reset: priority;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .priority-list li {
    counter-increment: priority;
    padding-left: var(--space-6);
    position: relative;
  }

  .priority-list li::before {
    content: counter(priority);
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid var(--signal);
    border-radius: 50%;
    color: var(--signal);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
  }
</style>
