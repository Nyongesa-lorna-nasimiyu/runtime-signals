---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const topics = (await getCollection('topics')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<BaseLayout title="Topics" description="Runtime Signals topic hubs." canonicalPath="/topics">
  <section class="listing">
    <header class="listing__header">
      <p class="eyebrow">Hubs</p>
      <h1>Topics</h1>
    </header>
    <ul class="topic-grid">
      {
        topics.map((topic) => (
          <li>
            <a href={`/topics/${topic.id}`} class="topic-card unstyled-link">
              <span class="topic-card__name">{topic.data.name}</span>
              <span class="topic-card__desc">{topic.data.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .listing {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }
  .listing__header h1 {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-6);
  }
  .topic-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-4);
  }
  .topic-card {
    display: block;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: var(--space-4);
    color: inherit;
  }
  .topic-card:hover {
    border-color: var(--signal);
  }
  .topic-card__name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .topic-card__desc {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
