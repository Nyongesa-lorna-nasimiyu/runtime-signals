{
  "name": "runtime-signals",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-approval-manifest.mjs && node scripts/check-mdx-imports.mjs",
    "build": "astro check && astro build",
    "postbuild": "node scripts/run-pagefind-index.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/generate-approval-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test -c tests/a11y/playwright.config.ts",
    "test:visual": "playwright test -c tests/visual/playwright.config.ts",
    "test:visual:update": "playwright test -c tests/visual/playwright.config.ts --update-snapshots",
    "verify:mdx": "node scripts/check-mdx-imports.mjs",
    "verify:otel": "node scripts/verify-otel.mjs",
    "verify:docs": "markdownlint-cli2 && node scripts/check-docs-links.mjs",
    "verify:manifest": "node scripts/generate-approval-manifest.mjs",
    "verify:pagefind-size": "node scripts/measure-pagefind-index.mjs",
    "verify:headers": "node scripts/verify-security-headers.mjs",
    "verify:action-pins": "node scripts/verify-action-pins.mjs",
    "verify:preview-metadata": "node scripts/verify-preview-metadata.mjs",
    "verify:preview-performance": "node scripts/verify-preview-performance.mjs",
    "verify:production": "node scripts/verify-production-health.mjs",
    "wrangler:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "@astrojs/react": "6.0.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.4",
    "@axe-core/playwright": "4.13.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "chrome-launcher": "1.2.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "lighthouse": "13.4.1",
    "markdownlint-cli2": "0.23.2",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "satori": "0.33.4",
    "serve": "14.2.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "unist-util-visit": "5.1.0",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
