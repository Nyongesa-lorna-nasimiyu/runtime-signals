---
import ArchiveLayout from '@/layouts/ArchiveLayout.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '@/lib/publication';
import { BUILD_TIME } from '@/lib/build-time';

const PAGE_SIZE = 10;
const articles = await getCollection('articles');
const live = getPublishedEntries(articles, BUILD_TIME);
const totalPages = Math.ceil(live.length / PAGE_SIZE);
---

<ArchiveLayout
  entries={live.slice(0, PAGE_SIZE)}
  allEntries={live}
  title="Articles"
  eyebrow="Long-Form Investigations"
  description="Deep-dives, architectural patterns, and tutorials tracing production failure mechanisms, formal runtime invariants, and verified engineering practices."
  canonicalPath="/articles"
  basePath="/articles"
  currentPage={1}
  totalPages={totalPages}
  showKindFilter
  emptyMessage="No published articles yet."
/>
